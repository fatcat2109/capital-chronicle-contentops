{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Institutional Browser QA Evidence + Metadata Reconciliation Packet",
  "type": "object",
  "required": [
    "packet_id", "created_at", "task_label", "reconciliation_mode",
    "runtime_authority", "static_local_only", "fixture_or_mock_data_only",
    "browser_rerun_now", "antigravity_used_now", "screenshot_capture_enabled_now",
    "file_export_enabled_now", "platform_upload_enabled_now",
    "active_frontend_code_changed_scope", "backend_server_required",
    "frontend_dependencies_added", "credential_read_allowed_now",
    "platform_api_allowed_now", "provider_llm_api_allowed_now",
    "repo_web_search_allowed_now", "live_posting_enabled_now",
    "scheduler_allowed_now", "scraping_allowed_now",
    "evidence_mutation_enabled_now", "project_sources_refresh_created_now",
    "browser_qa_evidence_packet", "browser_qa_screen_results",
    "minor_evidence_gap_registry", "screenshot_review_caveat",
    "global_header_metadata_reconciliation", "historical_screen_metadata_policy",
    "visual_export_antigravity_wording_policy", "long_label_readability_policy",
    "evidence_vault_update", "readme_update", "blocked_reasons", "packet_status"
  ],
  "properties": {
    "packet_id": {"type": "string"},
    "created_at": {"type": "string"},
    "task_label": {"type": "string"},
    "reconciliation_mode": {"type": "string"},
    "runtime_authority": {"type": "boolean", "const": false},
    "static_local_only": {"type": "boolean", "const": true},
    "fixture_or_mock_data_only": {"type": "boolean", "const": true},
    "browser_rerun_now": {"type": "boolean", "const": false},
    "antigravity_used_now": {"type": "boolean", "const": false},
    "screenshot_capture_enabled_now": {"type": "boolean", "const": false},
    "file_export_enabled_now": {"type": "boolean", "const": false},
    "platform_upload_enabled_now": {"type": "boolean", "const": false},
    "active_frontend_code_changed_scope": {"type": "string"},
    "backend_server_required": {"type": "boolean", "const": false},
    "frontend_dependencies_added": {"type": "boolean", "const": false},
    "credential_read_allowed_now": {"type": "boolean", "const": false},
    "platform_api_allowed_now": {"type": "boolean", "const": false},
    "provider_llm_api_allowed_now": {"type": "boolean", "const": false},
    "repo_web_search_allowed_now": {"type": "boolean", "const": false},
    "live_posting_enabled_now": {"type": "boolean", "const": false},
    "scheduler_allowed_now": {"type": "boolean", "const": false},
    "scraping_allowed_now": {"type": "boolean", "const": false},
    "evidence_mutation_enabled_now": {"type": "boolean", "const": false},
    "project_sources_refresh_created_now": {"type": "boolean", "const": false},
    "browser_qa_evidence_packet": {"type": "object"},
    "browser_qa_screen_results": {"type": "array", "minItems": 12},
    "minor_evidence_gap_registry": {"type": "array", "items": {"type": "string"}, "minItems": 4},
    "screenshot_review_caveat": {"type": "object"},
    "global_header_metadata_reconciliation": {"type": "object"},
    "historical_screen_metadata_policy": {"type": "object"},
    "visual_export_antigravity_wording_policy": {"type": "object"},
    "long_label_readability_policy": {"type": "object"},
    "evidence_vault_update": {"type": "object"},
    "readme_update": {"type": "object"},
    "blocked_reasons": {"type": "array"},
    "packet_status": {"type": "string", "enum": ["pass", "blocked", "fail"]},
    "kill_switch_status": {"type": "string"}
  }
}
