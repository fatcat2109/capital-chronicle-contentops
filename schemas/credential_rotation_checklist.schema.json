{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CredentialRotationChecklist",
  "description": "Standard checklist outlining security requirements for credentials before moving to live posting.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "platform_id", "rotation_required_before_live",
    "revocation_procedure_required_before_live", "suspected_leak_response"
  ],
  "properties": {
    "platform_id": { "type": "string", "minLength": 1 },
    "rotation_required_before_live": { "type": "boolean", "const": true },
    "revocation_procedure_required_before_live": { "type": "boolean", "const": true },
    "suspected_leak_response": {
      "type": "array",
      "items": { "type": "string" }
    },
    "operator_manual_steps_placeholder": {
      "type": "array",
      "items": { "type": "string" }
    },
    "unknowns": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
