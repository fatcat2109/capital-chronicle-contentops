{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Telegram Official Docs and Credential Validation Gate Packet",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "packet_id",
    "created_at",
    "runtime_authority",
    "task_label",
    "gate_mode",
    "candidate_platform_id",
    "linked_presence_check_task",
    "approved_env_source_label",
    "env_source_read_attempted",
    "env_source_read_succeeded",
    "telegram_bot_token_present",
    "telegram_target_chat_id_present",
    "telegram_bot_token_shape_class",
    "telegram_target_chat_id_shape_class",
    "official_docs_verification_attempted",
    "official_docs_source_domain",
    "official_docs_verified",
    "official_docs_fetch_count",
    "official_docs_fetch_budget",
    "official_docs_notes",
    "credential_validation_attempted",
    "credential_validation_method",
    "telegram_api_request_count",
    "telegram_api_request_budget",
    "telegram_api_allowed_now_for_getme_only",
    "telegram_api_called",
    "getme_called",
    "getme_validation_succeeded",
    "getme_response_redacted",
    "getme_bot_identity_confirmed",
    "bot_id_reported",
    "bot_username_reported",
    "token_value_printed",
    "chat_id_value_printed",
    "token_snippet_reported",
    "chat_id_snippet_reported",
    "exact_length_reported",
    "hash_or_digest_reported",
    "request_url_printed",
    "raw_response_printed",
    "api_error_redacted",
    "sendmessage_called",
    "getupdates_called",
    "live_adapter_enabled_now",
    "live_posting_enabled_now",
    "scheduler_allowed_now",
    "provider_llm_api_allowed_now",
    "repo_web_search_allowed_now_except_official_docs",
    "scraping_allowed_now",
    "backend_server_required",
    "publish_all_button_enabled_now",
    "one_button_publish_all_enabled_now",
    "final_social_copy_generated",
    "manual_review_required",
    "not_public_postable",
    "next_gate_required_before_posting",
    "channel_write_permission_validated",
    "channel_posting_validated",
    "blocked_action_policy",
    "safety_policy",
    "blocked_reasons",
    "packet_status"
  ],
  "properties": {
    "packet_id": { "type": "string" },
    "created_at": { "type": "string" },
    "runtime_authority": { "type": "boolean", "enum": [false] },
    "task_label": {
      "type": "string",
      "enum": ["TASK_CONTENTOPS_0156_TELEGRAM_OFFICIAL_DOCS_AND_CREDENTIAL_VALIDATION_GATE_NO_POST_V0"]
    },
    "gate_mode": {
      "type": "string",
      "enum": ["official_docs_and_getme_credential_validation_no_post"]
    },
    "candidate_platform_id": { "type": "string", "enum": ["telegram"] },
    "linked_presence_check_task": {
      "type": "string",
      "enum": ["TASK_CONTENTOPS_0155_TELEGRAM_REDACTED_CREDENTIAL_PRESENCE_CHECK_LOCAL_ONLY_V0"]
    },
    "approved_env_source_label": {
      "type": "string",
      "enum": [
        "OPERATOR_LOCAL_ENV_FILE_PROVIDED_OUT_OF_BAND",
        "APPROVED_LOCAL_ENV_SOURCE_REDACTED",
        "unavailable"
      ]
    },
    "env_source_read_attempted": { "type": "boolean" },
    "env_source_read_succeeded": { "type": "boolean" },
    "telegram_bot_token_present": { "type": ["boolean", "null"] },
    "telegram_target_chat_id_present": { "type": ["boolean", "null"] },
    "telegram_bot_token_shape_class": { "type": "string" },
    "telegram_target_chat_id_shape_class": { "type": "string" },
    "official_docs_verification_attempted": { "type": "boolean" },
    "official_docs_source_domain": { "type": "string", "enum": ["core.telegram.org", "none"] },
    "official_docs_verified": { "type": "boolean" },
    "official_docs_fetch_count": { "type": "integer", "minimum": 0, "maximum": 3 },
    "official_docs_fetch_budget": { "type": "integer", "enum": [3] },
    "official_docs_notes": { "type": "array", "items": { "type": "string" } },
    "credential_validation_attempted": { "type": "boolean" },
    "credential_validation_method": { "type": "string", "enum": ["getMe", "none"] },
    "telegram_api_request_count": { "type": "integer", "minimum": 0, "maximum": 1 },
    "telegram_api_request_budget": { "type": "integer", "enum": [1] },
    "telegram_api_allowed_now_for_getme_only": { "type": "boolean" },
    "telegram_api_called": { "type": "boolean" },
    "getme_called": { "type": "boolean" },
    "getme_validation_succeeded": { "type": "boolean" },
    "getme_response_redacted": { "type": "boolean" },
    "getme_bot_identity_confirmed": { "type": "boolean" },
    "bot_id_reported": { "type": "boolean", "enum": [false] },
    "bot_username_reported": { "type": "boolean", "enum": [false] },
    "token_value_printed": { "type": "boolean", "enum": [false] },
    "chat_id_value_printed": { "type": "boolean", "enum": [false] },
    "token_snippet_reported": { "type": "boolean", "enum": [false] },
    "chat_id_snippet_reported": { "type": "boolean", "enum": [false] },
    "exact_length_reported": { "type": "boolean", "enum": [false] },
    "hash_or_digest_reported": { "type": "boolean", "enum": [false] },
    "request_url_printed": { "type": "boolean", "enum": [false] },
    "raw_response_printed": { "type": "boolean", "enum": [false] },
    "api_error_redacted": { "type": "boolean" },
    "sendmessage_called": { "type": "boolean", "enum": [false] },
    "getupdates_called": { "type": "boolean", "enum": [false] },
    "live_adapter_enabled_now": { "type": "boolean", "enum": [false] },
    "live_posting_enabled_now": { "type": "boolean", "enum": [false] },
    "scheduler_allowed_now": { "type": "boolean", "enum": [false] },
    "provider_llm_api_allowed_now": { "type": "boolean", "enum": [false] },
    "repo_web_search_allowed_now_except_official_docs": { "type": "boolean", "enum": [false] },
    "scraping_allowed_now": { "type": "boolean", "enum": [false] },
    "backend_server_required": { "type": "boolean", "enum": [false] },
    "publish_all_button_enabled_now": { "type": "boolean", "enum": [false] },
    "one_button_publish_all_enabled_now": { "type": "boolean", "enum": [false] },
    "final_social_copy_generated": { "type": "boolean", "enum": [false] },
    "manual_review_required": { "type": "boolean", "enum": [true] },
    "not_public_postable": { "type": "boolean", "enum": [true] },
    "next_gate_required_before_posting": { "type": "boolean", "enum": [true] },
    "channel_write_permission_validated": { "type": "boolean", "enum": [false] },
    "channel_posting_validated": { "type": "boolean", "enum": [false] },
    "kill_switch_status": { "type": "string" },
    "blocked_action_policy": { "type": "object" },
    "safety_policy": { "type": "object" },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } },
    "packet_status": { "type": "string", "enum": ["pass", "blocked", "fail"] }
  }
}
