{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SCD CompilerV2ApprovalBridgePacket",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string" },
    "approval_bridge_packet_id": { "type": "string" },
    "compiler_output_id": { "type": "string" },
    "compile_report_id": { "type": "string" },
    "payload_hash_manifest_id": { "type": "string" },
    "compile_report_state": { "type": "string", "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"] },
    "approval_state": { "type": "string", "enum": ["approval_candidate_only", "manual_review_required"] },
    "payload_hash_match": { "type": "boolean" },
    "operator_review_required": { "type": "boolean" },
    "manual_review_required": { "type": "boolean" },
    "auto_approved": { "type": "boolean" },
    "operator_approved": { "type": "boolean" },
    "approval_bypass": { "type": "boolean" },
    "redacted_audit_required": { "type": "boolean" },
    "kill_switch_check_required": { "type": "boolean" },
    "revocation_required": { "type": "boolean" },
    "public_ready": { "type": "boolean" },
    "live_ready": { "type": "boolean" },
    "dispatch_ready": { "type": "boolean" },
    "executable_dispatch": { "type": "boolean" },
    "platform_api_allowed_now": { "type": "boolean" },
    "credential_read_allowed_now": { "type": "boolean" },
    "scheduler_enabled_now": { "type": "boolean" },
    "posting_enabled_now": { "type": "boolean" },
    "validation_state": { "type": "string", "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"] },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "schema_version",
    "approval_bridge_packet_id",
    "compiler_output_id",
    "compile_report_id",
    "compile_report_state",
    "approval_state",
    "payload_hash_match",
    "operator_review_required",
    "manual_review_required",
    "auto_approved",
    "operator_approved",
    "approval_bypass",
    "redacted_audit_required",
    "kill_switch_check_required",
    "revocation_required",
    "public_ready",
    "live_ready",
    "dispatch_ready",
    "executable_dispatch",
    "platform_api_allowed_now",
    "credential_read_allowed_now",
    "scheduler_enabled_now",
    "posting_enabled_now",
    "validation_state"
  ]
}
