{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PreAlphaDailyOperatorContentRunPacket",
  "description": "Local-only daily operator content run packet (Task 0111). Composes the accepted 0103-0110 pre-alpha ContentOps workbench into one deterministic operator summary for a single manual content run. It NEVER approves automatically, posts, schedules, calls a platform/provider/LLM/network, scrapes, ingests metrics, reads credentials, or produces public-postable/publish-ready output. Operator final check remains mandatory.",
  "type": "object",
  "properties": {
    "daily_operator_content_run_packet_id": { "type": "string" },
    "created_at": { "type": "string" },
    "run_label": { "type": "string" },
    "source_refs": { "type": "array", "items": { "type": "string" } },
    "source_packet_ids": { "type": "object" },
    "seed_and_calendar_summary": { "type": "object" },
    "dashboard_summary": { "type": "object" },
    "review_batch_summary": { "type": "object" },
    "decision_batch_summary": { "type": "object" },
    "export_batch_summary": { "type": "object" },
    "platform_template_summary": { "type": "object" },
    "manual_publish_record_summary": { "type": "object" },
    "ready_for_operator_copy_paste_count": { "type": "integer", "minimum": 0 },
    "blocked_or_not_ready_count": { "type": "integer", "minimum": 0 },
    "operator_action_queue": { "type": "array", "items": { "type": "string" } },
    "blocked_content_report": { "type": "array", "items": { "type": "object" } },
    "final_operator_checklist": { "type": "array", "items": { "type": "string" } },
    "hard_boundary_flags": { "$ref": "#/definitions/hard_boundary_flags" },
    "safety_audit": { "type": "object" },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } },
    "packet_status": { "type": "string", "enum": ["pass", "blocked"] }
  },
  "required": [
    "daily_operator_content_run_packet_id",
    "created_at",
    "run_label",
    "source_packet_ids",
    "seed_and_calendar_summary",
    "dashboard_summary",
    "review_batch_summary",
    "decision_batch_summary",
    "export_batch_summary",
    "platform_template_summary",
    "manual_publish_record_summary",
    "ready_for_operator_copy_paste_count",
    "blocked_or_not_ready_count",
    "operator_action_queue",
    "blocked_content_report",
    "final_operator_checklist",
    "hard_boundary_flags",
    "safety_audit",
    "blocked_reasons",
    "packet_status"
  ],
  "additionalProperties": true,
  "definitions": {
    "hard_boundary_flags": {
      "type": "object",
      "properties": {
        "local_only": { "type": "boolean", "const": true },
        "fixture_only": { "type": "boolean", "const": true },
        "manual_operator_workbench_only": { "type": "boolean", "const": true },
        "manual_review_required": { "type": "boolean", "const": true },
        "operator_final_check_required": { "type": "boolean", "const": true },
        "public_postable": { "type": "boolean", "const": false },
        "auto_approval": { "type": "boolean", "const": false },
        "auto_publish": { "type": "boolean", "const": false },
        "platform_api_call_allowed_now": { "type": "boolean", "const": false },
        "provider_call_allowed_now": { "type": "boolean", "const": false },
        "network_call_allowed_now": { "type": "boolean", "const": false },
        "scheduler_allowed": { "type": "boolean", "const": false },
        "automatic_metrics_ingestion_allowed": { "type": "boolean", "const": false },
        "scraping_allowed": { "type": "boolean", "const": false },
        "credential_or_env_read_allowed": { "type": "boolean", "const": false },
        "live_execution_allowed_now": { "type": "boolean", "const": false }
      },
      "required": [
        "local_only",
        "fixture_only",
        "manual_operator_workbench_only",
        "manual_review_required",
        "operator_final_check_required",
        "public_postable",
        "auto_approval",
        "auto_publish",
        "platform_api_call_allowed_now",
        "provider_call_allowed_now",
        "network_call_allowed_now",
        "scheduler_allowed",
        "automatic_metrics_ingestion_allowed",
        "scraping_allowed",
        "credential_or_env_read_allowed",
        "live_execution_allowed_now"
      ],
      "additionalProperties": true
    }
  }
}
