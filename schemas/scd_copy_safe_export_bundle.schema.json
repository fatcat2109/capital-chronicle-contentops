{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SCD CopySafeExportBundle",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string" },
    "copy_safe_export_bundle_id": { "type": "string" },
    "console_input_id": { "type": "string" },
    "export_mode": {
      "type": "string",
      "enum": ["copy_safe_text", "local_json_packet", "operator_review_packet"]
    },
    "export_sections": {
      "type": "object",
      "properties": {
        "operator_summary": { "type": "string" },
        "stage_status_summary": { "type": "string" },
        "blocker_summary": { "type": "string" },
        "evidence_summary": { "type": "string" },
        "safety_summary": { "type": "string" },
        "manual_publish_notice": { "type": "string" }
      },
      "required": ["operator_summary", "stage_status_summary", "manual_publish_notice"]
    },
    "copy_safe_text": { "type": "string" },
    "redaction_summary": { "type": "string" },
    "contains_credentials": { "type": "boolean" },
    "contains_tokens": { "type": "boolean" },
    "contains_platform_endpoints": { "type": "boolean" },
    "contains_raw_secret_material": { "type": "boolean" },
    "contains_unredacted_operator_identity": { "type": "boolean" },
    "contains_live_dispatch_instruction": { "type": "boolean" },
    "contains_public_ready_claim": { "type": "boolean" },
    "manual_publish_only_notice_included": { "type": "boolean" },
    "limitations_included": { "type": "boolean" },
    "citations_or_evidence_refs_included": { "type": "boolean" },
    "financial_advice_absent": { "type": "boolean" },
    "signal_language_absent": { "type": "boolean" },
    "manual_publish_only": { "type": "boolean" },
    "mock_only": { "type": "boolean" },
    "public_ready": { "type": "boolean" },
    "live_ready": { "type": "boolean" },
    "executable_dispatch": { "type": "boolean" },
    "api_gate_required": { "type": "boolean" },
    "validation_state": { "type": "string", "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"] },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "schema_version",
    "copy_safe_export_bundle_id",
    "console_input_id",
    "export_mode",
    "export_sections",
    "contains_credentials",
    "contains_tokens",
    "contains_platform_endpoints",
    "contains_raw_secret_material",
    "contains_unredacted_operator_identity",
    "contains_live_dispatch_instruction",
    "contains_public_ready_claim",
    "manual_publish_only_notice_included",
    "limitations_included",
    "citations_or_evidence_refs_included",
    "financial_advice_absent",
    "signal_language_absent",
    "manual_publish_only",
    "mock_only",
    "public_ready",
    "live_ready",
    "executable_dispatch",
    "api_gate_required",
    "validation_state"
  ]
}
