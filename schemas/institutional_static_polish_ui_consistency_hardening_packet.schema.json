{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Institutional Static Polish and UI Consistency Hardening Packet",
  "type": "object",
  "required": [
    "packet_id",
    "created_at",
    "task_label",
    "polish_mode",
    "required_starting_baseline",
    "prior_task_classification",
    "process_caveat_preserved",
    "static_local_only",
    "fixture_or_mock_data_only",
    "browser_opened_now",
    "browser_automation_used_now",
    "antigravity_used_now",
    "screenshot_capture_enabled_now",
    "file_export_enabled_now",
    "platform_upload_enabled_now",
    "project_sources_refresh_created_now",
    "credential_read_allowed_now",
    "platform_api_allowed_now",
    "provider_llm_api_allowed_now",
    "repo_web_search_allowed_now",
    "live_posting_enabled_now",
    "scheduler_allowed_now",
    "scraping_allowed_now",
    "evidence_mutation_enabled_now",
    "public_ready_final_copy_generated",
    "unsafe_signal_language_enabled",
    "red_green_market_direction_semantics",
    "secret_visible_count",
    "kill_switch_status",
    "screen_count",
    "current_global_metadata_consistent",
    "historical_metadata_policy_present",
    "stale_global_header_regression_count",
    "forbidden_controls_active_count",
    "packet_status"
  ],
  "properties": {
    "packet_id": { "type": "string" },
    "created_at": { "type": "string" },
    "task_label": { "type": "string" },
    "polish_mode": { "type": "string" },
    "required_starting_baseline": { "type": "string" },
    "prior_task_classification": { "type": "string" },
    "process_caveat_preserved": { "type": "boolean" },
    "static_local_only": { "type": "boolean" },
    "fixture_or_mock_data_only": { "type": "boolean" },
    "browser_opened_now": { "type": "boolean" },
    "browser_automation_used_now": { "type": "boolean" },
    "antigravity_used_now": { "type": "boolean" },
    "screenshot_capture_enabled_now": { "type": "boolean" },
    "file_export_enabled_now": { "type": "boolean" },
    "platform_upload_enabled_now": { "type": "boolean" },
    "project_sources_refresh_created_now": { "type": "boolean" },
    "credential_read_allowed_now": { "type": "boolean" },
    "platform_api_allowed_now": { "type": "boolean" },
    "provider_llm_api_allowed_now": { "type": "boolean" },
    "repo_web_search_allowed_now": { "type": "boolean" },
    "live_posting_enabled_now": { "type": "boolean" },
    "scheduler_allowed_now": { "type": "boolean" },
    "scraping_allowed_now": { "type": "boolean" },
    "evidence_mutation_enabled_now": { "type": "boolean" },
    "public_ready_final_copy_generated": { "type": "boolean" },
    "unsafe_signal_language_enabled": { "type": "boolean" },
    "red_green_market_direction_semantics": { "type": "boolean" },
    "secret_visible_count": { "type": "integer", "minimum": 0, "maximum": 0 },
    "kill_switch_status": { "type": "string", "enum": ["active"] },
    "screen_count": { "type": "integer", "minimum": 12, "maximum": 12 },
    "screens_present": { "type": "array", "items": { "type": "string" } },
    "current_global_metadata_consistent": { "type": "boolean", "enum": [true] },
    "historical_metadata_policy_present": { "type": "boolean", "enum": [true] },
    "stale_global_header_regression_count": { "type": "integer", "minimum": 0, "maximum": 0 },
    "forbidden_controls_active_count": { "type": "integer", "minimum": 0, "maximum": 0 },
    "current_accepted_baseline": { "type": "string" },
    "hero_block_count": { "type": "integer" },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } },
    "packet_status": { "type": "string", "enum": ["pass", "blocked", "fail"] }
  }
}
