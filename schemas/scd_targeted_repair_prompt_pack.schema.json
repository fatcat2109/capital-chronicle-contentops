{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SCDTargetedRepairPromptPack",
  "type": "object",
  "required": [
    "schema_version",
    "prompt_pack_id",
    "prompt_version",
    "prompt_hash",
    "brief_hash",
    "source_packet_hash",
    "model_config_ref",
    "lane",
    "validator_failure_refs"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "prompt_pack_id": { "type": "string" },
    "canonical_prompt_pack_id": { "type": "string" },
    "prompt_version": { "type": "string" },
    "prompt_hash": { "type": "string" },
    "brief_hash": { "type": "string" },
    "source_packet_hash": { "type": "string" },
    "model_config_ref": { "type": "string" },
    "lane": { "type": "string" },
    "target_platform": { "type": "string" },
    "audience_mode": { "type": "string" },
    "voice_profile": { "type": "string" },
    "allowed_angle": { "type": "string" },
    "forbidden_claims": { "type": "array", "items": { "type": "string" } },
    "required_limitations": { "type": "array", "items": { "type": "string" } },
    "required_source_refs": { "type": "array", "items": { "type": "string" } },
    "required_citation_policy": { "type": "string" },
    "repair_instructions": { "type": "string" },
    "validator_failure_refs": { "type": "array", "items": { "type": "string" } },
    "failing_section_refs": { "type": "array", "items": { "type": "string" } },
    "patch_only_failing_section": { "type": "boolean" },
    "forbid_full_rewrite": { "type": "boolean" },
    "forbid_new_claims": { "type": "boolean" },
    "preserve_citations": { "type": "boolean" },
    "preserve_limitations": { "type": "boolean" },
    "preserve_source_refs": { "type": "boolean" },
    "preserve_claim_meaning": { "type": "boolean" },
    "preserve_non_signal_framing": { "type": "boolean" },
    "provider_api_allowed": { "type": "boolean" },
    "network_allowed": { "type": "boolean" },
    "credentials_required": { "type": "boolean" },
    "quota_policy_id": { "type": "string" },
    "quota_policy_state": { "type": "string" },
    "max_targeted_repair_attempts": { "type": "integer" },
    "non_signal_framing_required": { "type": "boolean" },
    "financial_advice_absent_required": { "type": "boolean" },
    "model_output_never_authority": { "type": "boolean" },
    "provider_ready": { "type": "boolean" },
    "live_ready": { "type": "boolean" },
    "public_ready": { "type": "boolean" },
    "validation_state": { "type": "string" }
  },
  "additionalProperties": true
}
