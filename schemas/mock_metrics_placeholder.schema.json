{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MockMetricsPlaceholder",
  "description": "Local-only simulated/manual metrics placeholder (Task 0080). Never fetched or scraped.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metrics_id", "platform_id", "metrics_source",
    "fetched_from_platform", "scraped", "network_accessed"
  ],
  "properties": {
    "metrics_id": { "type": "string", "minLength": 1 },
    "mock_platform_post_id": { "type": ["string", "null"] },
    "platform_id": { "type": "string", "minLength": 1 },
    "metrics_source": {
      "type": "string",
      "enum": ["simulated_placeholder", "manual_placeholder"]
    },
    "fetched_from_platform": { "type": "boolean", "const": false },
    "scraped": { "type": "boolean", "const": false },
    "network_accessed": { "type": "boolean", "const": false },
    "values": { "type": ["object", "null"] }
  }
}
