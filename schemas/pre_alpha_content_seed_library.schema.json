{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PreAlphaContentSeedLibrary",
  "description": "Local-only seed library for the pre-alpha content engine (Task 0103). A library is a deterministic, fixture-driven collection of content seeds organized by content zone. It performs NO network/provider/LLM/platform/credential access, NEVER posts, NEVER fetches, and NEVER produces public-postable or publish-ready output. Each seed reuses the pre_alpha_content_seed contract plus a content_zone tag.",
  "type": "object",
  "properties": {
    "library_id": { "type": "string" },
    "created_at": { "type": "string" },
    "description": { "type": "string" },
    "seeds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "seed_id": { "type": "string" },
          "content_zone": {
            "type": "string",
            "enum": [
              "macro_education",
              "build_in_public",
              "product_update",
              "data_sufficiency",
              "forecast_readiness",
              "failure_forensics",
              "general_process"
            ]
          },
          "content_type": {
            "type": "string",
            "enum": [
              "data_sufficiency",
              "forecast_readiness",
              "failure_forensics",
              "build_in_public",
              "macro_education",
              "product_update",
              "market_note"
            ]
          },
          "content_source_type": {
            "type": "string",
            "enum": ["general_process", "product_update", "artifact_backed"]
          },
          "is_general_process_content": { "type": "boolean" },
          "source_artifact_ids": { "type": "array", "items": { "type": "string" } },
          "intended_platforms": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["x", "linkedin", "threads", "newsletter", "generic"]
            }
          },
          "audience": { "type": "string" },
          "thesis_or_angle": { "type": "string" },
          "title": { "type": "string" },
          "key_points": { "type": "array", "items": { "type": "string" } },
          "limitations": { "type": "array", "items": { "type": "string" } },
          "freshness_label": { "type": "string" },
          "data_sufficiency_status": {
            "type": "string",
            "enum": ["sufficient", "partial", "insufficient", "proxy_only", "missing", "not_applicable"]
          },
          "forecast_readiness_claim_requested": { "type": "boolean" },
          "forecast_readiness_supported_by_source": { "type": "boolean" }
        },
        "required": [
          "seed_id",
          "content_zone",
          "content_type",
          "content_source_type",
          "is_general_process_content",
          "title",
          "key_points"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": ["library_id", "seeds"],
  "additionalProperties": true
}
