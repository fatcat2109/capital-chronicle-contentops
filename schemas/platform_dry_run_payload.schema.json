{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Platform Dry Run Payload",
  "type": "object",
  "properties": {
    "dry_run": {
      "type": "boolean"
    },
    "platform_id": {
      "type": "string"
    },
    "post_id": {
      "type": "string"
    },
    "payload_preview": {
      "type": "object"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocking_errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "render_status": {
      "type": "string",
      "enum": [
        "rendered",
        "blocked"
      ]
    },
    "constraint_source": {
      "type": "string"
    },
    "requires_operator_approval": {
      "type": "boolean"
    },
    "not_public_postable": {
      "type": "boolean"
    },
    "live_posting_enabled": {
      "type": "boolean"
    },
    "platform_api_payload_generated": {
      "type": "boolean"
    },
    "credential_accessed": {
      "type": "boolean"
    },
    "network_accessed": {
      "type": "boolean"
    },
    "scheduler_accessed": {
      "type": "boolean"
    },
    "mock_endpoint_name": {
      "type": "string"
    }
  },
  "required": [
    "dry_run",
    "platform_id",
    "post_id",
    "payload_preview",
    "warnings",
    "blocking_errors",
    "render_status",
    "constraint_source",
    "requires_operator_approval",
    "not_public_postable",
    "live_posting_enabled",
    "platform_api_payload_generated",
    "credential_accessed",
    "network_accessed",
    "scheduler_accessed",
    "mock_endpoint_name"
  ]
}