{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capitalchronicle.example/schemas/CapitalChronicleContentEvidencePacketV3.schema.json",
  "title": "CapitalChronicleContentEvidencePacketV3",
  "description": "Additive generic-claim supersession of the frozen V2 evidence packet. The exact V2 payload remains embedded and projected at top level.",
  "type": "object",
  "required": [
    "schema_version",
    "packet_id",
    "generated_at_utc",
    "as_of_utc",
    "story_window",
    "events",
    "official_source_documents",
    "numeric_claims",
    "market_snapshots",
    "source_state",
    "candidate_visual_inputs",
    "citation_map",
    "provenance",
    "public_claim_permissions",
    "blockers",
    "supersedes_schema_version",
    "governed_claim_graph",
    "generic_claim_permissions",
    "v2_compatibility_projection",
    "v2_compatibility",
    "validation_blockers",
    "status",
    "logical_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "capital_chronicle_content_evidence_packet.v3"
    },
    "packet_id": {"type": "string", "minLength": 1},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "as_of_utc": {"type": "string", "format": "date-time"},
    "story_window": {"type": "object"},
    "events": {"type": "array", "items": {"type": "object"}},
    "official_source_documents": {
      "type": "array",
      "items": {"$ref": "#/$defs/source_document"}
    },
    "numeric_claims": {
      "type": "array",
      "items": {"$ref": "#/$defs/numeric_projection"}
    },
    "market_snapshots": {"type": "array", "items": {"type": "object"}},
    "source_state": {"type": "object"},
    "candidate_visual_inputs": {"type": "array", "items": {"type": "object"}},
    "citation_map": {"type": "object"},
    "provenance": {"type": "object"},
    "public_claim_permissions": {"type": "object"},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "bridge_safety": {"type": "object"},
    "supersedes_schema_version": {
      "const": "capital_chronicle_content_evidence_packet.v2"
    },
    "governed_claim_graph": {"$ref": "#/$defs/claim_graph"},
    "generic_claim_permissions": {
      "type": "object",
      "required": [
        "approved_claim_ids",
        "reporting_claims_allowed",
        "decision",
        "no_editorial_permission_upgrade"
      ],
      "properties": {
        "approved_claim_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "reporting_claims_allowed": {"type": "boolean"},
        "decision": {"enum": ["ALLOW", "BLOCK"]},
        "no_editorial_permission_upgrade": {"const": true}
      },
      "additionalProperties": false
    },
    "v2_compatibility_projection": {"$ref": "#/$defs/v2_packet"},
    "v2_compatibility": {
      "type": "object",
      "required": [
        "projection_schema_version",
        "top_level_numeric_claims_exact",
        "numeric_consumer_breaking_change",
        "nonnumeric_claim_requires_numeric_projection"
      ],
      "properties": {
        "projection_schema_version": {
          "const": "capital_chronicle_content_evidence_packet.v2"
        },
        "top_level_numeric_claims_exact": {"const": true},
        "numeric_consumer_breaking_change": {"const": false},
        "nonnumeric_claim_requires_numeric_projection": {"const": false}
      },
      "additionalProperties": false
    },
    "validation_blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "status": {
      "enum": ["PASS_CONTRACT_BLOCKED_PUBLICATION", "FAIL_SCHEMA"]
    },
    "logical_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true,
  "$defs": {
    "source_document": {
      "type": "object",
      "required": ["document_id", "authorized_urls"],
      "properties": {
        "document_id": {"type": "string", "minLength": 1},
        "authorized_urls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "format": "uri"}
        }
      },
      "additionalProperties": true
    },
    "numeric_projection": {
      "type": "object",
      "required": [
        "claim_id",
        "metric",
        "value",
        "unit",
        "observation_time_utc",
        "source_id",
        "source_artifact_ref",
        "llm_numeric_authority"
      ],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "metric": {"type": "string", "minLength": 1},
        "value": {"type": ["number", "integer"]},
        "unit": {"type": "string", "minLength": 1},
        "observation_time_utc": {"type": "string", "format": "date-time"},
        "source_id": {"type": "string", "minLength": 1},
        "source_artifact_ref": {"type": "string", "minLength": 1},
        "public_claim_allowed": {"type": "boolean"},
        "llm_numeric_authority": {"const": false}
      },
      "additionalProperties": true
    },
    "citation": {
      "type": "object",
      "required": ["source_document_id", "url"],
      "properties": {
        "source_document_id": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"}
      },
      "additionalProperties": true
    },
    "claim": {
      "type": "object",
      "required": [
        "schema_version",
        "claim_id",
        "claim_type",
        "structured_payload",
        "source_document_ids",
        "evidence_refs",
        "authority_class",
        "permission_state",
        "observed_at_utc",
        "event_time_utc",
        "published_at_utc",
        "known_at_utc",
        "revision_at_utc",
        "entities",
        "geographies",
        "citations",
        "limitations",
        "market_evidence_refs",
        "logical_hash"
      ],
      "properties": {
        "schema_version": {"const": "contentops.universal_news_claim.v2"},
        "claim_id": {"type": "string", "minLength": 1},
        "claim_type": {
          "enum": [
            "numeric_observation",
            "factual_text",
            "official_action",
            "legal_or_regulatory_action",
            "corporate_filing_fact",
            "event_occurrence",
            "entity_relationship",
            "correction_or_revision",
            "market_reaction",
            "model_assisted_judgment"
          ]
        },
        "statement": {"type": ["string", "null"]},
        "structured_payload": {"type": "object"},
        "source_document_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "authority_class": {"type": "string", "minLength": 1},
        "permission_state": {"type": "string", "minLength": 1},
        "observed_at_utc": {"type": ["string", "null"], "format": "date-time"},
        "event_time_utc": {"type": ["string", "null"], "format": "date-time"},
        "published_at_utc": {"type": ["string", "null"], "format": "date-time"},
        "known_at_utc": {"type": "string", "format": "date-time"},
        "revision_at_utc": {"type": ["string", "null"], "format": "date-time"},
        "entities": {"type": "array", "items": {"type": "string"}},
        "geographies": {"type": "array", "items": {"type": "string"}},
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/citation"}
        },
        "limitations": {"type": "array", "items": {"type": "string"}},
        "numeric": {"type": ["object", "null"]},
        "market_evidence_refs": {
          "type": "array",
          "items": {"type": "string"}
        },
        "judgment_record": {"type": ["object", "null"]},
        "logical_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "approval_decision": {
      "type": "object",
      "required": [
        "claim_id",
        "claim_type",
        "authority_class",
        "permission_state",
        "approved_for_reporting",
        "blockers",
        "decision_source"
      ],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "claim_type": {"type": "string", "minLength": 1},
        "authority_class": {"type": "string", "minLength": 1},
        "permission_state": {"type": "string", "minLength": 1},
        "approved_for_reporting": {"type": "boolean"},
        "blockers": {"type": "array", "items": {"type": "string"}},
        "decision_source": {
          "const": "DERIVED_FROM_GOVERNED_CLAIM_AND_CANDIDATE"
        }
      },
      "additionalProperties": false
    },
    "claim_graph": {
      "type": "object",
      "required": [
        "graph_version",
        "claims",
        "edges",
        "approved_claim_ids",
        "approval_decisions"
      ],
      "properties": {
        "graph_version": {"const": "contentops.governed_generic_claim_graph.v1"},
        "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
        "edges": {"type": "array", "items": {"type": "object"}},
        "approved_claim_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "approval_decisions": {
          "type": "array",
          "items": {"$ref": "#/$defs/approval_decision"}
        }
      },
      "additionalProperties": false
    },
    "v2_packet": {
      "type": "object",
      "required": [
        "schema_version",
        "packet_id",
        "generated_at_utc",
        "as_of_utc",
        "story_window",
        "events",
        "official_source_documents",
        "numeric_claims",
        "market_snapshots",
        "source_state",
        "candidate_visual_inputs",
        "citation_map",
        "provenance",
        "public_claim_permissions",
        "blockers"
      ],
      "properties": {
        "schema_version": {"const": "capital_chronicle_content_evidence_packet.v2"},
        "packet_id": {"type": "string", "minLength": 1},
        "generated_at_utc": {"type": "string", "format": "date-time"},
        "as_of_utc": {"type": "string", "format": "date-time"},
        "story_window": {"type": "object"},
        "events": {"type": "array", "items": {"type": "object"}},
        "official_source_documents": {
          "type": "array",
          "items": {"$ref": "#/$defs/source_document"}
        },
        "numeric_claims": {
          "type": "array",
          "items": {"$ref": "#/$defs/numeric_projection"}
        },
        "market_snapshots": {"type": "array", "items": {"type": "object"}},
        "source_state": {"type": "object"},
        "candidate_visual_inputs": {"type": "array", "items": {"type": "object"}},
        "citation_map": {"type": "object"},
        "provenance": {"type": "object"},
        "public_claim_permissions": {"type": "object"},
        "blockers": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  }
}