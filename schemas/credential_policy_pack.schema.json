{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CredentialPolicyPack",
  "description": "Local credential security policy pack (Task 0082). Never grants runtime authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pack_id", "platforms", "global_secret_rules",
    "no_runtime_credential_access", "docs_runtime_authority"
  ],
  "properties": {
    "pack_id": { "type": "string", "minLength": 1 },
    "platforms": {
      "type": "array",
      "items": { "type": "string" }
    },
    "global_secret_rules": {
      "type": "array",
      "items": { "type": "string" }
    },
    "no_runtime_credential_access": { "type": "boolean", "const": true },
    "docs_runtime_authority": { "type": "boolean", "const": false }
  }
}
