{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Content Calendar Spec Packet",
  "type": "object",
  "properties": {
    "content_calendar_spec_packet_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "calendar_lanes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "calendar_item_states": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "manual_publish_tracking_states": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "manual_metrics_tracking_states": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocked_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "packet_status": {
      "type": "string"
    }
  },
  "required": [
    "content_calendar_spec_packet_id",
    "created_at",
    "calendar_lanes",
    "calendar_item_states",
    "manual_publish_tracking_states",
    "manual_metrics_tracking_states",
    "blocked_reasons",
