{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SCD OperatorEvidenceSurfaceContract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "surface_schema_version": { "const": "0174bu-prep02-v1" },
    "surface_id": { "type": "string" },
    "source_task_label": { "const": "TASK_CONTENTOPS_0174BT_OPERATOR_EVIDENCE_SUMMARY_V0" },
    "source_evidence_baseline_head": { "const": "add55ea1c7447770cb9382f86af1794b951ae8f1" },
    "source_evidence_baseline_subject": { "const": "feat: add operator evidence summary for compiler v2 chain" },
    "operator_evidence_summary_id": { "type": "string" },
    "compiler_output_id": { "type": "string" },
    "compile_report_id": { "type": "string" },
    "payload_hash_manifest_id": { "type": "string" },
    "bridge_report_id": { "type": "string" },
    "bridge_report_hash": { "type": "string" },
    "readiness_alignment_id": { "type": "string" },
    "audit_alignment_id": { "type": "string" },
    "bridge_report_state": { "type": "string", "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"] },
    "readiness_alignment_state": { "type": "string", "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"] },
    "audit_alignment_state": { "type": "string", "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"] },
    "component_states": { "type": "array", "items": { "type": "string", "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"] } },
    "rollup_state": { "type": "string", "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"] },
    "blocker_count": { "type": "integer", "minimum": 0 },
    "review_required_count": { "type": "integer", "minimum": 0 },
    "unknown_count": { "type": "integer", "minimum": 0 },
    "evidence_only": { "const": true },
    "non_executable": { "const": true },
    "manual_review_required": { "const": true },
    "local_only": { "const": true },
    "ui_surface_ready": { "const": true },
    "public_ready": { "const": false },
    "live_ready": { "const": false },
    "dispatch_ready": { "const": false },
    "executable_dispatch": { "const": false },
    "platform_api_allowed_now": { "const": false },
    "credential_read_allowed_now": { "const": false },
    "scheduler_enabled_now": { "const": false },
    "posting_enabled_now": { "const": false },
    "audit_event_created": { "const": false },
    "audit_allowlist_modified": { "const": false },
    "readiness_granted": { "const": false },
    "no_grant_label": { "const": "EVIDENCE ONLY / NO GRANT" },
    "allowed_local_action": { "const": "inspect evidence only" },
    "blocked_actions": { "type": "array", "items": { "type": "string" } },
    "evidence_path_nodes": { "type": "array", "items": { "type": "string" } },
    "component_state_matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "component": { "type": "string" },
          "state": { "type": "string", "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"] },
          "evidence_id": { "type": "string" }
        },
        "required": ["component", "state"]
      }
    },
    "required_false_flag_matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "flag": { "type": "string" },
          "value": { "type": "boolean" }
        },
        "required": ["flag", "value"]
      }
    },
    "hostile_matrix_summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "total_cases": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "unknown": { "type": "integer", "minimum": 0 },
        "review_required": { "type": "integer", "minimum": 0 },
        "never_pass": { "type": "boolean" }
      },
      "required": ["total_cases", "never_pass"]
    },
    "truth_model_notes": { "type": "array", "items": { "type": "string" } },
    "validation_state": { "type": "string", "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"] },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "surface_schema_version",
    "surface_id",
    "source_task_label",
    "source_evidence_baseline_head",
    "source_evidence_baseline_subject",
    "operator_evidence_summary_id",
    "compiler_output_id",
    "compile_report_id",
    "payload_hash_manifest_id",
    "bridge_report_id",
    "bridge_report_hash",
    "readiness_alignment_id",
    "audit_alignment_id",
    "bridge_report_state",
    "readiness_alignment_state",
    "audit_alignment_state",
    "component_states",
    "rollup_state",
    "blocker_count",
    "review_required_count",
    "unknown_count",
    "evidence_only",
    "non_executable",
    "manual_review_required",
    "local_only",
    "ui_surface_ready",
    "public_ready",
    "live_ready",
    "dispatch_ready",
    "executable_dispatch",
    "platform_api_allowed_now",
    "credential_read_allowed_now",
    "scheduler_enabled_now",
    "posting_enabled_now",
    "audit_event_created",
    "audit_allowlist_modified",
    "readiness_granted",
    "no_grant_label",
    "allowed_local_action",
    "blocked_actions",
    "evidence_path_nodes",
    "component_state_matrix",
    "required_false_flag_matrix",
    "hostile_matrix_summary",
    "truth_model_notes",
    "validation_state",
    "blocked_reasons"
  ]
}
