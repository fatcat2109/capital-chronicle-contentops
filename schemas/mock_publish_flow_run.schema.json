{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MockPublishFlowRun",
  "description": "Local-only mock publish flow run summary (Task 0080).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id", "platforms_attempted", "platforms_mock_passed",
    "platforms_blocked", "audit_event_ids",
    "all_live_disabled", "all_network_disabled", "all_credentials_disabled"
  ],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "platforms_attempted": { "type": "array", "items": { "type": "string" } },
    "platforms_mock_passed": { "type": "array", "items": { "type": "string" } },
    "platforms_blocked": { "type": "array", "items": { "type": "string" } },
    "audit_event_ids": { "type": "array", "items": { "type": "string" } },
    "all_live_disabled": { "type": "boolean", "const": true },
    "all_network_disabled": { "type": "boolean", "const": true },
    "all_credentials_disabled": { "type": "boolean", "const": true }
  }
}
