{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SCD PlatformConstraintProfileV2",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string" },
    "profile_id": { "type": "string" },
    "platform_id": {
      "type": "string",
      "enum": [
        "telegram",
        "x_twitter",
        "linkedin",
        "facebook_page",
        "instagram",
        "threads",
        "tiktok",
        "substack_newsletter",
        "generic_manual"
      ]
    },
    "label": { "type": "string" },
    "content_surface": { "type": "string" },
    "payload_shape": {
      "type": "string",
      "enum": ["dry_run", "manual_export"]
    },
    "character_limit_max": { "type": "integer" },
    "character_limit_soft": { "type": "integer" },
    "supports_links": { "type": "boolean" },
    "supports_hashtags": { "type": "boolean" },
    "supports_threading": { "type": "boolean" },
    "supports_media": { "type": "boolean" },
    "required_disclosure_fields": { "type": "array", "items": { "type": "string" } },
    "required_limitation_fields": { "type": "array", "items": { "type": "string" } },
    "unsupported_features": { "type": "array", "items": { "type": "string" } },
    "registry_allowed_state": { "type": "string" },
    "manual_publish_only": { "type": "boolean" },
    "public_ready": { "type": "boolean" },
    "live_eligibility": { "type": "boolean" },
    "live_ready": { "type": "boolean" },
    "dispatch_ready": { "type": "boolean" },
    "live_api_enabled_now": { "type": "boolean" },
    "platform_api_allowed_now": { "type": "boolean" },
    "credential_read_allowed_now": { "type": "boolean" },
    "scheduler_enabled_now": { "type": "boolean" },
    "validation_state": {
      "type": "string",
      "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"]
    },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "schema_version",
    "profile_id",
    "platform_id",
    "label",
    "content_surface",
    "payload_shape",
    "character_limit_max",
    "supports_links",
    "supports_hashtags",
    "supports_threading",
    "supports_media",
    "required_disclosure_fields",
    "required_limitation_fields",
    "unsupported_features",
    "manual_publish_only",
    "validation_state"
  ]
}
