{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SCD Platform Capability Profile V2",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "platform_id",
    "display_name",
    "official_doc_source_ids",
    "endpoint_family_names_symbolic",
    "publish_capability_summary",
    "current_repo_allowed_state",
    "live_risk_level",
    "credential_slot_names_future_only",
    "credential_required_later",
    "app_review_or_verification_required",
    "restricted_access_or_cost_sensitive",
    "future_live_gate_required",
    "live_api_enabled_now",
    "platform_api_allowed_now",
    "credential_read_allowed_now",
    "credentials_requested_now",
    "posting_enabled_now",
    "scheduler_enabled_now",
    "autonomous_replies_enabled_now",
    "dms_enabled_now",
    "scraping_enabled_now",
    "public_ready",
    "live_ready",
    "dispatch_ready",
    "validation_state"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "profile_id": { "type": "string" },
    "platform_id": {
      "type": "string",
      "enum": [
        "telegram",
        "x_twitter",
        "linkedin",
        "facebook_page",
        "instagram",
        "threads",
        "tiktok",
        "substack_newsletter",
        "generic_manual"
      ]
    },
    "display_name": { "type": "string" },
    "official_doc_source_ids": { "type": "array", "items": { "type": "string" } },
    "endpoint_family_names_symbolic": { "type": "array", "items": { "type": "string" } },
    "publish_capability_summary": { "type": "string" },
    "current_repo_allowed_state": {
      "type": "string",
      "enum": [
        "dry_run_only",
        "manual_export_only",
        "future_live_gate_required",
        "unsupported_until_docs_verified",
        "blocked_unknown_docs"
      ]
    },
    "live_risk_level": { "type": "string" },
    "credential_slot_names_future_only": { "type": "array", "items": { "type": "string" } },
    "credential_required_later": { "type": "boolean" },
    "app_review_or_verification_required": { "type": "boolean" },
    "restricted_access_or_cost_sensitive": { "type": "boolean" },
    "future_live_gate_required": { "type": "boolean" },
    "first_future_supervised_live_candidate": { "type": "boolean" },
    "actual_channel_id_present": { "type": "boolean" },
    "posting_identity_modes": { "type": "array", "items": { "type": "string" } },
    "disclosure_and_policy_fields": { "type": "array", "items": { "type": "string" } },
    "future_priority": { "type": "string" },
    "api_write_publish_supported": { "type": "boolean" },
    "live_api_enabled_now": { "type": "boolean" },
    "platform_api_allowed_now": { "type": "boolean" },
    "credential_read_allowed_now": { "type": "boolean" },
    "credentials_requested_now": { "type": "boolean" },
    "posting_enabled_now": { "type": "boolean" },
    "scheduler_enabled_now": { "type": "boolean" },
    "autonomous_replies_enabled_now": { "type": "boolean" },
    "dms_enabled_now": { "type": "boolean" },
    "scraping_enabled_now": { "type": "boolean" },
    "public_ready": { "type": "boolean" },
    "live_ready": { "type": "boolean" },
    "dispatch_ready": { "type": "boolean" },
    "review_required_reasons": { "type": "array", "items": { "type": "string" } },
    "unsupported_or_unknown_fields": { "type": "array", "items": { "type": "string" } },
    "validation_state": {
      "type": "string",
      "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"]
    },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } }
  }
}
