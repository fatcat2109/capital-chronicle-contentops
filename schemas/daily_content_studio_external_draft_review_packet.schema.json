{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Daily Content Studio External Draft Review Packet",
  "type": "object",
  "properties": {
    "packet_id": { "type": "string" },
    "created_at": { "type": "string" },
    "operator_supplied": { "type": "boolean" },
    "runtime_authority": { "type": "boolean" },
    "review_mode": { "type": "string" },
    "linked_daily_content_studio_run_packet_id": { "type": "string" },
    "linked_markdown_review_export_id": { "type": "string" },
    "linked_operator_decision_ledger_packet_id": { "type": "string" },
    "external_draft_input": {
      "type": "object",
      "properties": {
        "draft_id": { "type": "string" },
        "draft_text": { "type": "string" },
        "draft_origin_label": { "type": "string" },
        "generated_outside_repo": { "type": "boolean" },
        "operator_pasted": { "type": "boolean" },
        "source_context_ids": { "type": "array", "items": { "type": "string" } },
        "selected_angle_card_ids": { "type": "array", "items": { "type": "string" } },
        "intended_content_type": { "type": "string" },
        "intended_platform_fit": { "type": "array", "items": { "type": "string" } },
        "limitation_notes_visible": { "type": "boolean" },
        "source_references_visible": { "type": "boolean" },
        "manual_review_required": { "type": "boolean" },
        "not_public_postable": { "type": "boolean" }
      },
      "required": [
        "draft_id",
        "draft_text",
        "draft_origin_label",
        "generated_outside_repo",
        "operator_pasted",
        "source_context_ids",
        "selected_angle_card_ids",
        "intended_content_type",
        "intended_platform_fit",
        "limitation_notes_visible",
        "source_references_visible",
        "manual_review_required",
        "not_public_postable"
      ]
    },
    "draft_origin_policy": { "type": "object" },
    "source_reference_policy": { "type": "object" },
    "limitation_visibility_policy": { "type": "object" },
    "claim_classification_policy": { "type": "object" },
    "angle_alignment_policy": { "type": "object" },
    "platform_fit_review_policy": { "type": "object" },
    "review_policy": { "type": "object" },
    "review_result": { "type": "object" },
    "output_policy": { "type": "object" },
    "safety_policy": { "type": "object" },
    "manual_operator_actions": { "type": "object" },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } },
    "packet_status": { "type": "string" }
  },
  "required": [
    "packet_id",
    "created_at",
    "operator_supplied",
    "runtime_authority",
    "review_mode",
    "linked_daily_content_studio_run_packet_id",
    "linked_markdown_review_export_id",
    "linked_operator_decision_ledger_packet_id",
    "external_draft_input",
    "draft_origin_policy",
    "source_reference_policy",
    "limitation_visibility_policy",
    "claim_classification_policy",
    "angle_alignment_policy",
    "platform_fit_review_policy",
    "review_policy",
    "review_result",
    "output_policy",
    "safety_policy",
    "manual_operator_actions",
    "blocked_reasons",
    "packet_status"
  ]
}
