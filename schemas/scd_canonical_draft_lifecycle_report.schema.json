{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SCDCanonicalDraftLifecycleReport",
  "type": "object",
  "required": [
    "schema_version",
    "lifecycle_state",
    "validation_state"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "lifecycle_state": { "type": "string" },
    "validation_state": { "type": "string" },
    "attempt_count_canonical": { "type": "integer" },
    "attempt_count_repair": { "type": "integer" },
    "total_provider_call_plans": { "type": "integer" },
    "reasons": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
