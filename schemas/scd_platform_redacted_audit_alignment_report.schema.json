{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SCD Platform Redacted Audit Alignment Report",
  "type": "object",
  "required": [
    "schema_version",
    "report_id",
    "profile_count",
    "platform_response_logging_future_only",
    "platform_response_redaction_required_later",
    "credential_values_forbidden",
    "credential_logging_forbidden",
    "credential_printing_forbidden",
    "credential_commit_forbidden",
    "credential_value_present",
    "live_event_present",
    "platform_api_called",
    "contradiction_count",
    "contradictions",
    "validation_state"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "report_id": { "type": "string" },
    "profile_count": { "type": "integer" },
    "platform_response_logging_future_only": { "type": "boolean" },
    "platform_response_redaction_required_later": { "type": "boolean" },
    "credential_values_forbidden": { "type": "boolean" },
    "credential_logging_forbidden": { "type": "boolean" },
    "credential_printing_forbidden": { "type": "boolean" },
    "credential_commit_forbidden": { "type": "boolean" },
    "credential_value_present": { "type": "boolean" },
    "live_event_present": { "type": "boolean" },
    "platform_api_called": { "type": "boolean" },
    "contradiction_count": { "type": "integer" },
    "contradictions": { "type": "array", "items": { "type": "string" } },
    "validation_state": {
      "type": "string",
      "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"]
    },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } }
  }
}
