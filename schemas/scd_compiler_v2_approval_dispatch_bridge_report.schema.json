{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SCD CompilerV2ApprovalDispatchBridgeReport",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string" },
    "bridge_report_id": { "type": "string" },
    "compiler_output_id": { "type": "string" },
    "compile_report_id": { "type": "string" },
    "payload_hash_manifest_id": { "type": "string" },
    "approval_bridge_packet_id": { "type": "string" },
    "dispatch_bridge_packet_id": { "type": "string" },
    "payload_hash_manifest_state": { "type": "string", "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"] },
    "approval_bridge_state": { "type": "string", "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"] },
    "dispatch_bridge_state": { "type": "string", "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"] },
    "final_recommendation": { "type": "string", "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"] },
    "local_only": { "type": "boolean" },
    "evidence_only": { "type": "boolean" },
    "non_executable": { "type": "boolean" },
    "manual_review_required": { "type": "boolean" },
    "operator_review_required": { "type": "boolean" },
    "public_ready": { "type": "boolean" },
    "live_ready": { "type": "boolean" },
    "dispatch_ready": { "type": "boolean" },
    "executable_dispatch": { "type": "boolean" },
    "platform_api_allowed_now": { "type": "boolean" },
    "credential_read_allowed_now": { "type": "boolean" },
    "scheduler_enabled_now": { "type": "boolean" },
    "validation_state": { "type": "string", "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"] },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "schema_version",
    "bridge_report_id",
    "compiler_output_id",
    "payload_hash_manifest_state",
    "approval_bridge_state",
    "dispatch_bridge_state",
    "final_recommendation",
    "local_only",
    "evidence_only",
    "non_executable",
    "manual_review_required",
    "public_ready",
    "live_ready",
    "dispatch_ready",
    "executable_dispatch",
    "platform_api_allowed_now",
    "credential_read_allowed_now",
    "scheduler_enabled_now",
    "validation_state"
  ]
}
