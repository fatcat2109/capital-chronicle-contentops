{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SCD MockDispatchExecutionRequest",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string" },
    "mock_execution_request_id": { "type": "string" },
    "gate_result_id": { "type": "string" },
    "gate_request_id": { "type": "string" },
    "dispatch_packet_id": { "type": "string" },
    "freeze_manifest_id": { "type": "string" },
    "approval_ledger_entry_id": { "type": "string" },
    "operator_decision_id": { "type": "string" },
    "platform_targets": { "type": "array", "items": { "type": "string" } },
    "frozen_payload_hash_refs": { "type": "array", "items": { "type": "string" } },
    "requested_mock_action": {
      "type": "string",
      "enum": ["create_mock_record", "create_manual_export_packet", "create_audit_binding", "dry_run_validate_only"]
    },
    "precondition_summary": {
      "type": "object",
      "properties": {
        "gate_result_pass": { "type": "boolean" },
        "freeze_manifest_complete": { "type": "boolean" },
        "approval_ledger_pass": { "type": "boolean" },
        "dispatch_packet_not_live": { "type": "boolean" },
        "payload_hashes_present": { "type": "boolean" },
        "audit_binding_required": { "type": "boolean" },
        "kill_switch_clear_for_mock": { "type": "boolean" },
        "no_blocked_states": { "type": "boolean" }
      },
      "required": [
        "gate_result_pass",
        "freeze_manifest_complete",
        "approval_ledger_pass",
        "dispatch_packet_not_live",
        "payload_hashes_present",
        "audit_binding_required",
        "kill_switch_clear_for_mock",
        "no_blocked_states"
      ]
    },
    "manual_publish_only": { "type": "boolean" },
    "mock_only": { "type": "boolean" },
    "network_allowed": { "type": "boolean" },
    "credential_access_allowed": { "type": "boolean" },
    "platform_api_allowed": { "type": "boolean" },
    "live_execution_allowed": { "type": "boolean" },
    "operator_review_required": { "type": "boolean" },
    "public_ready": { "type": "boolean" },
    "live_ready": { "type": "boolean" },
    "executable_dispatch": { "type": "boolean" },
    "validation_state": {
      "type": "string",
      "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"]
    },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "schema_version",
    "mock_execution_request_id",
    "gate_result_id",
    "requested_mock_action",
    "precondition_summary",
    "manual_publish_only",
    "mock_only",
    "network_allowed",
    "credential_access_allowed",
    "platform_api_allowed",
    "live_execution_allowed",
    "operator_review_required",
    "public_ready",
    "live_ready",
    "executable_dispatch",
    "validation_state"
  ]
}
