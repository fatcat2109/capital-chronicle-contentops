{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SCD EditorialCritiquePacket",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string" },
    "critique_id": { "type": "string" },
    "request_id": { "type": "string" },
    "output_id": { "type": "string" },
    "before_text_hash_or_ref": { "type": "string" },
    "after_text_hash_or_ref": { "type": "string" },
    "quality_score_local_only": { "type": "number" },
    "clarity_score": { "type": "number" },
    "credibility_score": { "type": "number" },
    "safety_score": { "type": "number" },
    "source_integrity_score": { "type": "number" },
    "limitation_preservation_result": {
      "type": "string",
      "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"]
    },
    "claim_preservation_result": {
      "type": "string",
      "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"]
    },
    "citation_integrity_result": {
      "type": "string",
      "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"]
    },
    "hallucination_check_result": {
      "type": "string",
      "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"]
    },
    "forbidden_language_result": {
      "type": "string",
      "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"]
    },
    "final_recommendation": {
      "type": "string",
      "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"]
    },
    "operator_review_required": { "type": "boolean" },
    "public_ready": { "type": "boolean" },
    "approved_by_system": { "type": "boolean" },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "schema_version",
    "critique_id",
    "request_id",
    "output_id",
    "limitation_preservation_result",
    "claim_preservation_result",
    "citation_integrity_result",
    "hallucination_check_result",
    "forbidden_language_result",
    "final_recommendation",
    "operator_review_required",
    "public_ready"
  ]
}
