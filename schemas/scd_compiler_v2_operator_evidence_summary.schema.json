{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SCD CompilerV2OperatorEvidenceSummary",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string" },
    "operator_evidence_summary_id": { "type": "string" },
    "compiler_output_id": { "type": "string" },
    "compile_report_id": { "type": "string" },
    "payload_hash_manifest_id": { "type": "string" },
    "bridge_report_id": { "type": "string" },
    "bridge_report_hash": { "type": "string" },
    "readiness_alignment_id": { "type": "string" },
    "audit_alignment_id": { "type": "string" },
    "bridge_report_state": { "type": "string", "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"] },
    "readiness_alignment_state": { "type": "string", "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"] },
    "audit_alignment_state": { "type": "string", "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"] },
    "component_states": { "type": "array", "items": { "type": "string", "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"] } },
    "rollup_state": { "type": "string", "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"] },
    "blocker_count": { "type": "integer", "minimum": 0 },
    "review_required_count": { "type": "integer", "minimum": 0 },
    "unknown_count": { "type": "integer", "minimum": 0 },
    "evidence_only": { "type": "boolean" },
    "non_executable": { "type": "boolean" },
    "manual_review_required": { "type": "boolean" },
    "local_only": { "type": "boolean" },
    "operator_visible": { "type": "boolean" },
    "ui_ready_packet": { "type": "boolean" },
    "bridge_report_bound": { "type": "boolean" },
    "lineage_complete": { "type": "boolean" },
    "bridge_hash_matches": { "type": "boolean" },
    "alignment_ids_bound": { "type": "boolean" },
    "lineage_ids_consistent": { "type": "boolean" },
    "public_ready": { "type": "boolean" },
    "live_ready": { "type": "boolean" },
    "dispatch_ready": { "type": "boolean" },
    "executable_dispatch": { "type": "boolean" },
    "platform_api_allowed_now": { "type": "boolean" },
    "credential_read_allowed_now": { "type": "boolean" },
    "credentials_requested_now": { "type": "boolean" },
    "scheduler_enabled_now": { "type": "boolean" },
    "posting_enabled_now": { "type": "boolean" },
    "autonomous_replies_enabled_now": { "type": "boolean" },
    "dms_enabled_now": { "type": "boolean" },
    "scraping_enabled_now": { "type": "boolean" },
    "audit_event_created": { "type": "boolean" },
    "audit_allowlist_modified": { "type": "boolean" },
    "readiness_granted": { "type": "boolean" },
    "operator_summary_mode": { "type": "string" },
    "allowed_operator_action": { "type": "string" },
    "forbidden_operator_actions": { "type": "array", "items": { "type": "string" } },
    "validation_state": { "type": "string", "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"] },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "schema_version",
    "operator_evidence_summary_id",
    "compiler_output_id",
    "compile_report_id",
    "payload_hash_manifest_id",
    "bridge_report_id",
    "bridge_report_hash",
    "readiness_alignment_id",
    "audit_alignment_id",
    "bridge_report_state",
    "readiness_alignment_state",
    "audit_alignment_state",
    "rollup_state",
    "blocker_count",
    "review_required_count",
    "unknown_count",
    "evidence_only",
    "non_executable",
    "manual_review_required",
    "local_only",
    "operator_visible",
    "ui_ready_packet",
    "bridge_report_bound",
    "bridge_hash_matches",
    "lineage_ids_consistent",
    "public_ready",
    "live_ready",
    "dispatch_ready",
    "executable_dispatch",
    "platform_api_allowed_now",
    "credential_read_allowed_now",
    "credentials_requested_now",
    "scheduler_enabled_now",
    "posting_enabled_now",
    "autonomous_replies_enabled_now",
    "dms_enabled_now",
    "scraping_enabled_now",
    "audit_event_created",
    "audit_allowlist_modified",
    "readiness_granted",
    "operator_summary_mode",
    "allowed_operator_action",
    "validation_state",
    "blocked_reasons"
  ]
}
