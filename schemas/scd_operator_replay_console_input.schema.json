{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SCD OperatorReplayConsoleInput",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string" },
    "console_input_id": { "type": "string" },
    "pipeline_replay_report_id": { "type": "string" },
    "safety_summary_id": { "type": "string" },
    "evidence_manifest_id": { "type": "string" },
    "mock_run_report_id": { "type": "string" },
    "audit_binding_id": { "type": "string" },
    "replay_report_validation_state": {
      "type": "string",
      "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"]
    },
    "requested_view": {
      "type": "string",
      "enum": ["operator_overview", "evidence_bundle", "blocker_review", "copy_safe_export"]
    },
    "operator_id_ref": { "type": "string" },
    "expected_manual_publish_only": { "type": "boolean" },
    "expected_mock_only": { "type": "boolean" },
    "allow_provider_api": { "type": "boolean" },
    "allow_network": { "type": "boolean" },
    "allow_credentials": { "type": "boolean" },
    "allow_platform_api": { "type": "boolean" },
    "allow_live_dispatch": { "type": "boolean" },
    "allow_browser_automation": { "type": "boolean" },
    "allow_ui_runtime_execution": { "type": "boolean" },
    "validation_state": {
      "type": "string",
      "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"]
    },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "schema_version",
    "console_input_id",
    "pipeline_replay_report_id",
    "requested_view",
    "expected_manual_publish_only",
    "expected_mock_only",
    "allow_provider_api",
    "allow_network",
    "allow_credentials",
    "allow_platform_api",
    "allow_live_dispatch",
    "allow_browser_automation",
    "allow_ui_runtime_execution",
    "validation_state"
  ]
}
