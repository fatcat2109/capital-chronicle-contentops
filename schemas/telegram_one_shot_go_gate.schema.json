{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "platform_id": {
      "type": "string",
      "enum": [
        "telegram"
      ]
    },
    "requested_mode": {
      "type": "string",
      "enum": [
        "sandbox_one_shot_live"
      ]
    },
    "source_packet_id": {
      "type": "string"
    },
    "source_packet_dry_run_ready": {
      "type": "boolean"
    },
    "source_queue_item_validated": {
      "type": "boolean"
    },
    "automation_policy_allows_sandbox_one_shot": {
      "type": "boolean"
    },
    "exact_go_phrase_present": {
      "type": "string"
    },
    "approval_ledger_state": {
      "type": "string",
      "enum": [
        "operator_approved_for_one_shot_later"
      ]
    },
    "kill_switch_state": {
      "type": "string",
      "enum": [
        "permit_only_scoped_telegram_live_pilot"
      ]
    },
    "redaction_state": {
      "type": "string",
      "enum": [
        "redacted"
      ]
    },
    "target_channel_state": {
      "type": "string",
      "enum": [
        "private_sandbox_placeholder_only"
      ]
    },
    "credential_source_required_later": {
      "type": "string",
      "enum": [
        "process_env_only"
      ]
    },
    "env_file_read_allowed": {
      "type": "boolean"
    },
    "live_attempt_count": {
      "type": "integer",
      "minimum": 0
    },
    "max_live_attempts": {
      "type": "integer",
      "const": 1
    },
    "network_accessed": {
      "type": "boolean"
    },
    "env_read_performed": {
      "type": "boolean"
    },
    "telegram_api_called": {
      "type": "boolean"
    },
    "live_post_sent": {
      "type": "boolean"
    },
    "scheduling_enabled": {
      "type": "boolean"
    },
    "replies_or_dms_enabled": {
      "type": "boolean"
    },
    "scraping_enabled": {
      "type": "boolean"
    },
    "metrics_fetched": {
      "type": "boolean"
    },
    "autonomous_mode": {
      "type": "boolean"
    }
  },
  "required": [
    "platform_id",
    "requested_mode",
    "source_packet_id",
    "exact_go_phrase_present"
  ]
}