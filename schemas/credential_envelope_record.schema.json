{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CredentialEnvelopeRecord",
  "description": "Local design envelope mapping how credentials will be handled without storing or accessing them (Task 0082). Never contains real token values.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelope_id", "platform_id", "credential_kind",
    "storage_location_policy", "env_var_names",
    "required_scopes_or_permissions", "verification_status",
    "credential_requirement_source", "placeholder_until_official_docs_verified",
    "live_use_allowed_now", "credential_value_present",
    "credential_value_stored_in_repo", "credential_value_logged",
    "credential_accessed_by_repo", "env_read_performed", "network_accessed"
  ],
  "properties": {
    "envelope_id": { "type": "string", "minLength": 1 },
    "platform_id": { "type": "string", "minLength": 1 },
    "credential_kind": {
      "type": "string",
      "enum": [
        "oauth2_user_context",
        "oauth2_app_only",
        "bot_token",
        "page_access_token",
        "user_access_token",
        "developer_api_key"
      ]
    },
    "storage_location_policy": {
      "type": "string",
      "enum": [
        "external_env_later",
        "external_secret_manager_later",
        "operator_supplied_runtime_later"
      ]
    },
    "env_var_names": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "required_scopes_or_permissions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "least_privilege_notes": { "type": "string" },
    "rotation_policy": { "type": "string" },
    "revocation_policy": { "type": "string" },
    "redaction_policy_id": { "type": "string" },
    "verification_status": {
      "type": "string",
      "enum": ["not_verified", "partially_verified", "verified"]
    },
    "credential_requirement_source": {
      "type": "string",
      "enum": ["local_placeholder_until_0081_official_docs_verified", "operator_supplied_docs_verified"]
    },
    "placeholder_until_official_docs_verified": { "type": "boolean" },
    "live_use_allowed_now": { "type": "boolean", "const": false },
    "credential_value_present": { "type": "boolean", "const": false },
    "credential_value_stored_in_repo": { "type": "boolean", "const": false },
    "credential_value_logged": { "type": "boolean", "const": false },
    "credential_accessed_by_repo": { "type": "boolean", "const": false },
    "env_read_performed": { "type": "boolean", "const": false },
    "network_accessed": { "type": "boolean", "const": false }
  }
}
