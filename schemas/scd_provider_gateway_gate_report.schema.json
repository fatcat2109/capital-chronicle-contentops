{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SCDProviderGatewayGateReport",
  "type": "object",
  "required": [
    "schema_version",
    "report_id",
    "final_recommendation"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "report_id": { "type": "string" },
    "dry_run_input_ref": { "type": "string" },
    "call_plan_ref": { "type": "string" },
    "spend_ledger_entry_ref": { "type": "string" },
    "dry_run_result_ref": { "type": "string" },
    "input_result": { "type": "string" },
    "call_plan_result": { "type": "string" },
    "spend_ledger_result": { "type": "string" },
    "dry_run_result_result": { "type": "string" },
    "per_object_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "object_name": { "type": "string" },
          "result": { "type": "string" },
          "reasons": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "executable": { "type": "boolean" },
    "provider_ready": { "type": "boolean" },
    "live_ready": { "type": "boolean" },
    "public_ready": { "type": "boolean" },
    "ready_for_future_provider_gate_review": { "type": "boolean" },
    "operator_review_required": { "type": "boolean" },
    "final_recommendation": { "type": "string" },
    "validation_state": { "type": "string" }
  },
  "additionalProperties": true
}
