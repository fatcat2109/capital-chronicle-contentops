{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Secret Redaction Policy",
  "type": "object",
  "properties": {
    "redaction_policy_id": {
      "type": "string"
    },
    "redaction_required": {
      "type": "boolean"
    },
    "redaction_marker": {
      "type": "string"
    },
    "forbidden_plaintext_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_placeholder_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "audit_log_redaction_required": {
      "type": "boolean"
    },
    "commit_redaction_required": {
      "type": "boolean"
    },
    "operator_copy_paste_warning": {
      "type": "string"
    },
    "blocked_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "redaction_policy_id",
    "redaction_required",
    "redaction_marker",
    "forbidden_plaintext_patterns",
    "allowed_placeholder_patterns",
    "audit_log_redaction_required",
    "commit_redaction_required",
    "operator_copy_paste_warning",
    "blocked_reasons"
  ]
}