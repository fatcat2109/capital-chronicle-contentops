{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RedactedAuditEvent",
  "type": "object",
  "properties": {
    "audit_event_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "event_type": {
      "type": "string"
    },
    "source_record_id": {
      "type": "string"
    },
    "platform_id": {
      "type": "string"
    },
    "dry_run": {
      "type": "boolean"
    },
    "mock_only": {
      "type": "boolean"
    },
    "live_execution": {
      "type": "boolean"
    },
    "network_accessed": {
      "type": "boolean"
    },
    "credential_accessed": {
      "type": "boolean"
    },
    "scheduler_accessed": {
      "type": "boolean"
    },
    "redaction_applied": {
      "type": "boolean"
    },
    "redacted_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "audit_payload": {
      "type": "object"
    },
    "unsafe_secret_detected": {
      "type": "boolean"
    },
    "blocked_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "audit_event_id",
    "created_at",
    "event_type",
    "source_record_id",
    "platform_id",
    "dry_run",
    "mock_only",
    "live_execution",
    "network_accessed",
    "credential_accessed",
    "scheduler_accessed",
    "redaction_applied",
    "redacted_fields",
    "audit_payload",
    "unsafe_secret_detected",
    "blocked_reasons"
  ]
}
