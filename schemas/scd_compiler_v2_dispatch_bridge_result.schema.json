{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SCD CompilerV2DispatchBridgeResult",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string" },
    "bridge_result_id": { "type": "string" },
    "bridge_mode": { "type": "string" },
    "compiler_output_id": { "type": "string" },
    "compile_report_id": { "type": "string" },
    "derived_platform_payload_hashes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "approval_reconciliation": {
      "type": "object",
      "properties": {
        "ledger_entry_id": { "type": "string" },
        "hash_match": { "type": "boolean" },
        "derived_hash_count": { "type": "integer" },
        "ref_hash_count": { "type": "integer" },
        "lineage_matches_report": { "type": "boolean" },
        "result": { "type": "string", "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"] },
        "reasons": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["result", "reasons"]
    },
    "dispatch_reconciliation": {
      "type": "object",
      "properties": {
        "gate_request_id": { "type": "string" },
        "freeze_manifest_id": { "type": "string" },
        "claimed_compile_pass": { "type": "boolean" },
        "report_recommendation": { "type": "string" },
        "claim_consistent": { "type": "boolean" },
        "hash_match": { "type": "boolean" },
        "derived_hash_count": { "type": "integer" },
        "ref_hash_count": { "type": "integer" },
        "result": { "type": "string", "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"] },
        "reasons": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["result", "reasons"]
    },
    "final_recommendation": { "type": "string", "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"] },
    "mock_dispatch_ready": { "type": "boolean" },
    "dispatch_ready": { "type": "boolean" },
    "live_ready": { "type": "boolean" },
    "executable_dispatch": { "type": "boolean" },
    "public_ready": { "type": "boolean" },
    "live_eligibility": { "type": "boolean" },
    "live_api_enabled_now": { "type": "boolean" },
    "platform_api_allowed_now": { "type": "boolean" },
    "credential_read_allowed_now": { "type": "boolean" },
    "credentials_requested_now": { "type": "boolean" },
    "posting_enabled_now": { "type": "boolean" },
    "scheduler_enabled_now": { "type": "boolean" },
    "autonomous_replies_enabled_now": { "type": "boolean" },
    "dms_enabled_now": { "type": "boolean" },
    "scraping_enabled_now": { "type": "boolean" },
    "operator_review_required": { "type": "boolean" },
    "validation_state": { "type": "string", "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"] },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "schema_version",
    "bridge_mode",
    "compiler_output_id",
    "compile_report_id",
    "approval_reconciliation",
    "dispatch_reconciliation",
    "final_recommendation",
    "operator_review_required",
    "validation_state"
  ]
}
