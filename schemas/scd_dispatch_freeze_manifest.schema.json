{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SCD DispatchFreezeManifest",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string" },
    "freeze_manifest_id": { "type": "string" },
    "freeze_timestamp": { "type": "string" },
    "canonical_post_hash": { "type": "string" },
    "platform_payload_hashes": { "type": "array", "items": { "type": "string" } },
    "approval_packet_hash": { "type": "string" },
    "operator_decision_hash": { "type": "string" },
    "compile_report_hash": { "type": "string" },
    "ledger_entry_hash": { "type": "string" },
    "freeze_algorithm": {
      "type": "string",
      "enum": ["canonical_json_sha256"]
    },
    "freeze_complete": { "type": "boolean" },
    "mutation_after_freeze_detected": { "type": "boolean" },
    "manual_publish_only": { "type": "boolean" },
    "live_ready": { "type": "boolean" },
    "executable_dispatch": { "type": "boolean" },
    "validation_state": {
      "type": "string",
      "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"]
    },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "schema_version",
    "freeze_manifest_id",
    "freeze_timestamp",
    "freeze_algorithm",
    "freeze_complete",
    "mutation_after_freeze_detected",
    "manual_publish_only",
    "live_ready",
    "executable_dispatch",
    "validation_state"
  ]
}
