{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SCDLLMQuotaRetryPolicy",
  "type": "object",
  "required": [
    "schema_version",
    "policy_id",
    "validation_state"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "policy_id": { "type": "string" },
    "policy_scope": { "type": "string" },
    "provider_api_allowed": { "type": "boolean" },
    "network_allowed": { "type": "boolean" },
    "credentials_required": { "type": "boolean" },
    "max_generation_attempts": { "type": "integer" },
    "max_targeted_repair_attempts": { "type": "integer" },
    "max_full_rewrite_attempts": { "type": "integer" },
    "explicit_operator_override": { "type": "boolean" },
    "allow_infinite_retry": { "type": "boolean" },
    "allow_full_rewrite_loop": { "type": "boolean" },
    "pre_llm_validation_required": { "type": "boolean" },
    "post_llm_validation_required": { "type": "boolean" },
    "deterministic_validator_primary": { "type": "boolean" },
    "llm_critique_optional_only": { "type": "boolean" },
    "llm_critique_enabled": { "type": "boolean" },
    "llm_critique_budget": { "type": ["integer", "string"] },
    "platform_variants_require_canonical_pass": { "type": "boolean" },
    "targeted_repair_only_for_minor_failures": { "type": "boolean" },
    "preserve_citations_required": { "type": "boolean" },
    "preserve_limitations_required": { "type": "boolean" },
    "preserve_source_refs_required": { "type": "boolean" },
    "preserve_claim_meaning_required": { "type": "boolean" },
    "preserve_non_signal_framing_required": { "type": "boolean" },
    "review_required_after_second_failure": { "type": "boolean" },
    "block_after_major_safety_failure": { "type": "boolean" },
    "cache_key_required": { "type": "boolean" },
    "cache_key_components": { "type": "array", "items": { "type": "string" } },
    "spend_tracking_required": { "type": "boolean" },
    "spend_fields_required": { "type": "array", "items": { "type": "string" } },
    "model_output_never_authority": { "type": "boolean" },
    "human_review_required_on_failure": { "type": "boolean" },
    "no_public_ready_claim": { "type": "boolean" },
    "no_live_dispatch": { "type": "boolean" },
    "policy_note": { "type": "string" },
    "validation_state": { "type": "string" }
  },
  "additionalProperties": true
}
