    "created_at",
    "task_label",
    "required_starting_baseline",
    "prior_accepted_task",
    "prior_accepted_classification",
    "current_task_gate_label",
    "baseline_semantics",
    "current_global_state",
    "historical_provenance_policy",
    "browser_qa_evidence_provenance",
    "screen_inventory",
    "safety_posture",
    "blocked_action_policy",
    "next_task_discipline",
    "future_handoff",
    "static_local_only",
    "browser_opened_now",
    "browser_automation_used_now",
    "antigravity_used_now",
    "screenshot_capture_enabled_now",
    "file_export_enabled_now",
    "platform_upload_enabled_now",
    "project_sources_refresh_created_now",
    "credential_read_allowed_now",
    "platform_api_allowed_now",
    "provider_llm_api_allowed_now",
    "repo_web_search_allowed_now",
    "live_posting_enabled_now",
    "scheduler_allowed_now",
    "scraping_allowed_now",
    "evidence_mutation_enabled_now",
    "public_ready_final_copy_generated",
    "unsafe_signal_language_enabled",
    "red_green_market_direction_semantics",
    "secret_visible_count",
    "kill_switch_status",
    "screen_count",
    "source_of_truth_model_present",
    "global_metadata_source_of_truth_present",
    "historical_metadata_policy_present",
    "browser_qa_evidence_provenance_present",
    "current_vs_historical_metadata_separated",
    "stale_global_header_regression_count",
    "forbidden_controls_active_count",
    "fixture_drift_guard_present",
    "prior_task_classification",
    "blocked_reasons",
    "packet_status"
  ],
  "properties": {
    "packet_id": { "type": "string" },
    "created_at": { "type": "string" },
    "task_label": { "type": "string" },
    "required_starting_baseline": { "type": "string", "const": "667f0ad" },
    "prior_accepted_task": { "type": "string" },
    "prior_accepted_classification": { "type": "string" },
    "current_task_gate_label": { "type": "string" },
    "baseline_semantics": { "type": "string" },
    "current_global_state": { "type": "object" },
    "historical_provenance_policy": { "type": "object" },
    "browser_qa_evidence_provenance": { "type": "object" },
    "screen_inventory": { "type": "array", "items": { "type": "string" }, "minItems": 12 },
    "safety_posture": { "type": "object" },
    "blocked_action_policy": { "type": "object" },
    "next_task_discipline": { "type": "string" },
    "future_handoff": { "type": "string" },
    "static_local_only": { "const": true },
    "browser_opened_now": { "const": false },
    "browser_automation_used_now": { "const": false },
    "antigravity_used_now": { "const": false },
    "screenshot_capture_enabled_now": { "const": false },
    "file_export_enabled_now": { "const": false },
    "platform_upload_enabled_now": { "const": false },
    "project_sources_refresh_created_now": { "const": false },
    "credential_read_allowed_now": { "const": false },
    "platform_api_allowed_now": { "const": false },
    "provider_llm_api_allowed_now": { "const": false },
    "repo_web_search_allowed_now": { "const": false },
    "live_posting_enabled_now": { "const": false },
    "scheduler_allowed_now": { "const": false },
    "scraping_allowed_now": { "const": false },
    "evidence_mutation_enabled_now": { "const": false },
    "public_ready_final_copy_generated": { "const": false },
    "unsafe_signal_language_enabled": { "const": false },
    "red_green_market_direction_semantics": { "const": false },
    "secret_visible_count": { "type": "integer", "minimum": 0, "maximum": 0 },
    "kill_switch_status": { "type": "string", "const": "active" },
    "screen_count": { "type": "integer", "minimum": 12, "maximum": 12 },
    "source_of_truth_model_present": { "const": true },
    "global_metadata_source_of_truth_present": { "const": true },
    "historical_metadata_policy_present": { "const": true },
    "browser_qa_evidence_provenance_present": { "const": true },
    "current_vs_historical_metadata_separated": { "const": true },
    "stale_global_header_regression_count": { "type": "integer", "minimum": 0, "maximum": 0 },
    "forbidden_controls_active_count": { "type": "integer", "minimum": 0, "maximum": 0 },
    "fixture_drift_guard_present": { "const": true },
    "prior_task_classification": { "type": "string", "const": "PASS" },
    "drift_findings": { "type": "array" },
    "blocked_reasons": { "type": "array" },
    "packet_status": { "type": "string", "enum": ["pass", "blocked", "fail"] }
  }
}
