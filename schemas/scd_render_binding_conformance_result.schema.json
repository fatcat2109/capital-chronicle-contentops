{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SCDRenderBindingConformanceResult",
  "type": "object",
  "required": [
    "schema_version",
    "conformance_result_id",
    "golden_snapshot_id",
    "replay_state",
    "validation_state"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "conformance_result_id": { "type": "string" },
    "golden_snapshot_id": { "type": "string" },
    "actual_render_spec_id": { "type": "string" },
    "replay_state": { "type": "string", "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"] },
    "conformance_mode": { "type": "string", "enum": ["exact_canonical_json", "structural_binding_only"] },
    "expected_canonical_json_sha256": { "type": "string" },
    "actual_canonical_json_sha256": { "type": "string" },
    "canonical_json_match": { "type": "boolean" },
    "structural_binding_match": { "type": "boolean" },
    "missing_regions": { "type": "array", "items": { "type": "string" } },
    "extra_regions": { "type": "array", "items": { "type": "string" } },
    "missing_display_slots": { "type": "array", "items": { "type": "string" } },
    "extra_display_slots": { "type": "array", "items": { "type": "string" } },
    "missing_status_tokens": { "type": "array", "items": { "type": "string" } },
    "extra_status_tokens": { "type": "array", "items": { "type": "string" } },
    "mismatched_bindings": { "type": "array", "items": { "type": "string" } },
    "mutation_detected": { "type": "boolean" },
    "display_only": { "type": "boolean" },
    "action_enabled": { "type": "boolean" },
    "ui_runtime_required": { "type": "boolean" },
    "browser_required": { "type": "boolean" },
    "screenshot_required": { "type": "boolean" },
    "html_css_js_required": { "type": "boolean" },
    "public_ready": { "type": "boolean" },
    "live_ready": { "type": "boolean" },
    "executable_dispatch": { "type": "boolean" },
    "api_gate_required": { "type": "boolean" },
    "validation_state": { "type": "string" }
  },
  "additionalProperties": true
}
