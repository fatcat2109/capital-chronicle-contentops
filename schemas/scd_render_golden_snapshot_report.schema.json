{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SCDRenderGoldenSnapshotReport",
  "type": "object",
  "required": [
    "schema_version",
    "golden_snapshot_report_id",
    "golden_snapshot_manifest_id",
    "final_recommendation",
    "validation_state"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "golden_snapshot_report_id": { "type": "string" },
    "golden_snapshot_manifest_id": { "type": "string" },
    "conformance_results": { "type": "array", "items": { "type": "string" } },
    "pass_results": { "type": "array", "items": { "type": "string" } },
    "blocked_results": { "type": "array", "items": { "type": "string" } },
    "review_required_results": { "type": "array", "items": { "type": "string" } },
    "unknown_results": { "type": "array", "items": { "type": "string" } },
    "missing_required_replay_states": { "type": "array", "items": { "type": "string" } },
    "failed_hash_matches": { "type": "array", "items": { "type": "string" } },
    "failed_structural_matches": { "type": "array", "items": { "type": "string" } },
    "mutation_detected_refs": { "type": "array", "items": { "type": "string" } },
    "display_contract_locked": { "type": "boolean" },
    "all_required_states_covered": { "type": "boolean" },
    "no_ui_runtime_required": { "type": "boolean" },
    "no_browser_required": { "type": "boolean" },
    "no_screenshot_required": { "type": "boolean" },
    "no_html_css_js_edits": { "type": "boolean" },
    "no_api_required": { "type": "boolean" },
    "final_recommendation": { "type": "string", "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"] },
    "operator_next_action": { "type": "string" },
    "display_only": { "type": "boolean" },
    "action_enabled": { "type": "boolean" },
    "manual_publish_only": { "type": "boolean" },
    "mock_only": { "type": "boolean" },
    "public_ready": { "type": "boolean" },
    "live_ready": { "type": "boolean" },
    "executable_dispatch": { "type": "boolean" },
    "api_gate_required": { "type": "boolean" },
    "validation_state": { "type": "string" }
  },
  "additionalProperties": true
}
