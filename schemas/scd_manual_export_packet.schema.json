{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SCD ManualExportPacket",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string" },
    "manual_export_packet_id": { "type": "string" },
    "mock_execution_record_id": { "type": "string" },
    "platform_payload_refs": { "type": "array", "items": { "type": "string" } },
    "platform_payload_hash_refs": { "type": "array", "items": { "type": "string" } },
    "export_surfaces": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["clipboard_safe_text", "local_json_packet", "operator_review_packet"]
      }
    },
    "export_mode": { "type": "string", "enum": ["manual_only"] },
    "export_contains_credentials": { "type": "boolean" },
    "export_contains_tokens": { "type": "boolean" },
    "export_contains_platform_endpoint": { "type": "boolean" },
    "limitations_included": { "type": "boolean" },
    "citations_included": { "type": "boolean" },
    "financial_advice_absent": { "type": "boolean" },
    "signal_language_absent": { "type": "boolean" },
    "manual_publish_only_notice_included": { "type": "boolean" },
    "public_ready": { "type": "boolean" },
    "live_ready": { "type": "boolean" },
    "executable_dispatch": { "type": "boolean" },
    "validation_state": {
      "type": "string",
      "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"]
    },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "schema_version",
    "manual_export_packet_id",
    "mock_execution_record_id",
    "export_mode",
    "export_contains_credentials",
    "export_contains_tokens",
    "export_contains_platform_endpoint",
    "limitations_included",
    "citations_included",
    "financial_advice_absent",
    "signal_language_absent",
    "manual_publish_only_notice_included",
    "public_ready",
    "live_ready",
    "executable_dispatch",
    "validation_state"
  ]
}
