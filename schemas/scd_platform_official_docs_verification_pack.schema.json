{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SCD Platform Official Docs Verification Pack",
  "type": "object",
  "required": [
    "schema_version",
    "verification_pack_id",
    "task_label",
    "baseline_commit",
    "retrieved_date",
    "ground_search_methodology",
    "official_doc_sources",
    "advisory_only",
    "runtime_authority",
    "validation_state"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "verification_pack_id": { "type": "string" },
    "task_label": { "type": "string" },
    "baseline_commit": { "type": "string" },
    "retrieved_date": { "type": "string" },
    "ground_search_methodology": { "type": "string" },
    "official_doc_sources": {
      "type": "array",
      "items": { "type": "object" }
    },
    "advisory_only": { "type": "boolean" },
    "runtime_authority": { "type": "boolean" },
    "validation_state": {
      "type": "string",
      "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"]
    },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } }
  }
}
