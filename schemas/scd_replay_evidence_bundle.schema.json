{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SCD ReplayEvidenceBundle",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string" },
    "evidence_bundle_id": { "type": "string" },
    "console_input_id": { "type": "string" },
    "pipeline_replay_report_id": { "type": "string" },
    "safety_summary_id": { "type": "string" },
    "evidence_manifest_id": { "type": "string" },
    "mock_run_report_id": { "type": "string" },
    "audit_binding_id": { "type": "string" },
    "stage_packet_hash_refs": { "type": "array", "items": { "type": "string" } },
    "validator_refs": { "type": "array", "items": { "type": "string" } },
    "fixture_refs": { "type": "array", "items": { "type": "string" } },
    "test_refs": { "type": "array", "items": { "type": "string" } },
    "redacted_audit_refs": { "type": "array", "items": { "type": "string" } },
    "protected_path_statement": { "type": "string" },
    "validation_commands_summary": { "type": "string" },
    "safety_scan_summary": { "type": "string" },
    "evidence_complete": { "type": "boolean" },
    "missing_evidence_refs": { "type": "array", "items": { "type": "string" } },
    "secrets_redacted": { "type": "boolean" },
    "tokens_absent": { "type": "boolean" },
    "credentials_absent": { "type": "boolean" },
    "endpoints_absent": { "type": "boolean" },
    "raw_payloads_redacted": { "type": "boolean" },
    "manual_publish_only": { "type": "boolean" },
    "mock_only": { "type": "boolean" },
    "public_ready": { "type": "boolean" },
    "live_ready": { "type": "boolean" },
    "executable_dispatch": { "type": "boolean" },
    "api_gate_required": { "type": "boolean" },
    "validation_state": { "type": "string", "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"] },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "schema_version",
    "evidence_bundle_id",
    "console_input_id",
    "pipeline_replay_report_id",
    "protected_path_statement",
    "evidence_complete",
    "secrets_redacted",
    "tokens_absent",
    "credentials_absent",
    "endpoints_absent",
    "raw_payloads_redacted",
    "manual_publish_only",
    "mock_only",
    "public_ready",
    "live_ready",
    "executable_dispatch",
    "api_gate_required",
    "validation_state"
  ]
}
