{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Credential Envelope Policy Packet",
  "type": "object",
  "properties": {
    "credential_envelope_policy_packet_id": {
      "type": "string"
    },
    "created_at": {
      "type": "string"
    },
    "operator_supplied": {
      "type": "boolean"
    },
    "runtime_authority": {
      "type": "boolean"
    },
    "credential_records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "credential_record_id": {
            "type": "string"
          },
          "platform_id": {
            "type": "string"
          },
          "credential_purpose": {
            "type": "string"
          },
          "credential_kind": {
            "type": "string",
            "enum": [
              "api_key",
              "oauth_client_id",
              "oauth_client_secret",
              "access_token",
              "refresh_token",
              "bot_token",
              "webhook_secret",
              "app_id",
              "app_secret",
              "unknown"
            ]
          },
          "credential_label": {
            "type": "string"
          },
          "env_var_name_placeholder": {
            "type": "string"
          },
          "secret_value_present": {
            "type": "boolean"
          },
          "secret_value_redacted": {
            "type": "boolean"
          },
          "credential_value_loaded": {
            "type": "boolean"
          },
          "credential_presence_checked": {
            "type": "boolean"
          },
          "env_file_accessed": {
            "type": "boolean"
          },
          "credential_read_allowed_now": {
            "type": "boolean"
          },
          "platform_api_call_allowed_now": {
            "type": "boolean"
          },
          "posting_allowed_now": {
            "type": "boolean"
          },
          "scheduler_allowed_now": {
            "type": "boolean"
          },
          "scraping_allowed_now": {
            "type": "boolean"
          },
          "metrics_api_allowed_now": {
            "type": "boolean"
          },
          "future_live_gate_required": {
            "type": "boolean"
          },
          "operator_rotation_note": {
            "type": "string"
          },
          "blocked_reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "credential_record_id",
          "platform_id",
          "credential_purpose",
          "credential_kind",
          "credential_label",
          "env_var_name_placeholder",
          "secret_value_present",
          "secret_value_redacted",
          "credential_value_loaded",
          "credential_presence_checked",
          "env_file_accessed",
          "credential_read_allowed_now",
          "platform_api_call_allowed_now",
          "posting_allowed_now",
          "scheduler_allowed_now",
          "scraping_allowed_now",
          "metrics_api_allowed_now",
          "future_live_gate_required",
          "operator_rotation_note",
          "blocked_reasons"
        ]
      }
    },
    "secret_redaction_policy": {
      "$ref": "secret_redaction_policy.schema.json"
    },
    "future_live_gate_requirements": {
      "type": "object",
      "properties": {
        "operator_explicit_live_gate_required": {
          "type": "boolean"
        },
        "official_docs_verified_required": {
          "type": "boolean"
        },
        "credential_storage_plan_required": {
          "type": "boolean"
        },
        "secret_rotation_plan_required": {
          "type": "boolean"
        },
        "manual_dry_run_success_required": {
          "type": "boolean"
        },
        "kill_switch_enabled_required": {
          "type": "boolean"
        },
        "redacted_audit_required": {
          "type": "boolean"
        },
        "platform_by_platform_approval_required": {
          "type": "boolean"
        },
        "live_execution_allowed_now": {
          "type": "boolean"
        }
      },
      "required": [
        "operator_explicit_live_gate_required",
        "official_docs_verified_required",
        "credential_storage_plan_required",
        "secret_rotation_plan_required",
        "manual_dry_run_success_required",
        "kill_switch_enabled_required",
        "redacted_audit_required",
        "platform_by_platform_approval_required",
        "live_execution_allowed_now"
      ]
    },
    "hard_boundary_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blocked_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "packet_status": {
      "type": "string"
    }
  },
  "required": [
    "credential_envelope_policy_packet_id",
    "created_at",
    "operator_supplied",
    "runtime_authority",
    "credential_records",
    "secret_redaction_policy",
    "future_live_gate_requirements",
    "hard_boundary_flags",
    "blocked_reasons",
    "packet_status"
  ]
}