{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CredentialRedactionPolicy",
  "description": "Redaction policy schema defining rules to wipe secret patterns from audit trails (Task 0082).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "redaction_policy_id", "secret_like_patterns", "replacement_token",
    "audit_safe", "blocks_unredacted_secret", "fake_token_test_only"
  ],
  "properties": {
    "redaction_policy_id": { "type": "string", "minLength": 1 },
    "secret_like_patterns": {
      "type": "array",
      "items": { "type": "string" }
    },
    "replacement_token": { "type": "string", "minLength": 1 },
    "audit_safe": { "type": "boolean", "const": true },
    "blocks_unredacted_secret": { "type": "boolean", "const": true },
    "fake_token_test_only": { "type": "boolean", "const": true }
  }
}
