{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "gate_id": {
      "type": "string"
    },
    "platform_id": {
      "type": "string",
      "enum": [
        "telegram"
      ]
    },
    "gate_status": {
      "type": "string",
      "enum": [
        "design_only",
        "blocked",
        "ready_for_explicit_live_go"
      ]
    },
    "live_execution_allowed_now": {
      "type": "boolean"
    },
    "credential_accessed_by_repo": {
      "type": "boolean"
    },
    "env_read_performed": {
      "type": "boolean"
    },
    "network_accessed": {
      "type": "boolean"
    },
    "telegram_api_called": {
      "type": "boolean"
    },
    "live_post_sent": {
      "type": "boolean"
    },
    "scheduling_enabled": {
      "type": "boolean"
    },
    "replies_or_dms_enabled": {
      "type": "boolean"
    },
    "scraping_enabled": {
      "type": "boolean"
    },
    "metrics_fetched": {
      "type": "boolean"
    },
    "public_postable": {
      "type": "boolean"
    },
    "requires_explicit_operator_go": {
      "type": "boolean"
    },
    "exact_live_go_phrase": {
      "type": "string"
    },
    "allowed_live_scope_later": {
      "type": "string"
    },
    "forbidden_live_scope": {
      "type": "string"
    },
    "required_preflight_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_dry_run_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_approval_ledger_state": {
      "type": "string"
    },
    "required_kill_switch_state": {
      "type": "string"
    },
    "required_credential_policy_state": {
      "type": "string"
    },
    "required_redaction_state": {
      "type": "string"
    },
    "rollback_plan": {
      "type": "string"
    },
    "manual_fallback_plan": {
      "type": "string"
    },
    "operator_final_checklist": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "gate_id",
    "platform_id",
    "gate_status",
    "live_execution_allowed_now",
    "credential_accessed_by_repo",
    "env_read_performed",
    "network_accessed",
    "telegram_api_called",
    "live_post_sent",
    "scheduling_enabled",
    "replies_or_dms_enabled",
    "scraping_enabled",
    "metrics_fetched",
    "public_postable",
    "requires_explicit_operator_go",
    "exact_live_go_phrase"
  ],
  "additionalProperties": false
}