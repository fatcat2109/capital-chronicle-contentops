{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SCD Platform Credential Slot Policy",
  "type": "object",
  "required": [
    "schema_version",
    "policy_id",
    "platform_credential_slots",
    "credential_value_present",
    "credential_validation_enabled_now",
    "env_read_allowed_now",
    "os_env_read_allowed_now",
    "secret_redaction_required",
    "no_secret_scan_required",
    "validation_state"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "policy_id": { "type": "string" },
    "platform_credential_slots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "platform_id",
          "slot_names",
          "slot_values_present",
          "credential_requested_now",
          "credential_read_allowed_now",
          "future_only"
        ],
        "properties": {
          "platform_id": { "type": "string" },
          "slot_names": { "type": "array", "items": { "type": "string" } },
          "slot_values_present": { "type": "boolean" },
          "credential_requested_now": { "type": "boolean" },
          "credential_read_allowed_now": { "type": "boolean" },
          "future_only": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    },
    "credential_value_present": { "type": "boolean" },
    "credential_validation_enabled_now": { "type": "boolean" },
    "env_read_allowed_now": { "type": "boolean" },
    "os_env_read_allowed_now": { "type": "boolean" },
    "secret_redaction_required": { "type": "boolean" },
    "no_secret_scan_required": { "type": "boolean" },
    "validation_state": {
      "type": "string",
      "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"]
    },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } }
  }
}
