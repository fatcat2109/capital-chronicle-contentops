{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SCD CompilerV2DispatchBridgePacket",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string" },
    "dispatch_bridge_packet_id": { "type": "string" },
    "compiler_output_id": { "type": "string" },
    "compile_report_id": { "type": "string" },
    "payload_hash_manifest_id": { "type": "string" },
    "approval_bridge_packet_id": { "type": "string" },
    "compile_report_state": { "type": "string", "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"] },
    "approval_bridge_state": { "type": "string", "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"] },
    "approval_operator_approved": { "type": "boolean" },
    "approval_auto_approved": { "type": "boolean" },
    "approval_bypass_present": { "type": "boolean" },
    "dispatch_state": {
      "type": "string",
      "enum": ["dispatch_gate_candidate_only", "non_executable_dispatch_packet", "manual_review_required"]
    },
    "payload_hash_match": { "type": "boolean" },
    "freeze_candidate_only": { "type": "boolean" },
    "manual_operator_review_required": { "type": "boolean" },
    "operator_approval_present": { "type": "boolean" },
    "executable_dispatch": { "type": "boolean" },
    "dispatch_ready": { "type": "boolean" },
    "live_ready": { "type": "boolean" },
    "public_ready": { "type": "boolean" },
    "platform_api_allowed_now": { "type": "boolean" },
    "credential_read_allowed_now": { "type": "boolean" },
    "scheduler_enabled_now": { "type": "boolean" },
    "posting_enabled_now": { "type": "boolean" },
    "precondition_summary": {
      "type": "object",
      "properties": {
        "compiler_output_bound": { "type": "boolean" },
        "compiler_report_bound": { "type": "boolean" },
        "payload_hash_manifest_bound": { "type": "boolean" },
        "approval_candidate_bound": { "type": "boolean" },
        "platform_compile_pass": { "type": "boolean" },
        "platform_compile_review_required": { "type": "boolean" },
        "platform_compile_unknown": { "type": "boolean" },
        "platform_compile_blocked": { "type": "boolean" },
        "operator_approval_present": { "type": "boolean" },
        "executable_dispatch_allowed": { "type": "boolean" }
      },
      "required": [
        "compiler_output_bound",
        "compiler_report_bound",
        "payload_hash_manifest_bound",
        "approval_candidate_bound",
        "platform_compile_pass",
        "platform_compile_review_required",
        "platform_compile_unknown",
        "platform_compile_blocked",
        "operator_approval_present",
        "executable_dispatch_allowed"
      ]
    },
    "validation_state": { "type": "string", "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"] },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "schema_version",
    "dispatch_bridge_packet_id",
    "compiler_output_id",
    "compile_report_id",
    "compile_report_state",
    "dispatch_state",
    "payload_hash_match",
    "freeze_candidate_only",
    "manual_operator_review_required",
    "operator_approval_present",
    "executable_dispatch",
    "dispatch_ready",
    "live_ready",
    "public_ready",
    "platform_api_allowed_now",
    "credential_read_allowed_now",
    "scheduler_enabled_now",
    "posting_enabled_now",
    "precondition_summary",
    "validation_state"
  ]
}
