    "created_at": {
      "type": "string"
    },
    "source_ui_ux_spec_packet_id": {
      "type": "string"
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "views": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fixture_cards": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "safety_banners": {
      "type": "array",
