{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SCD ReplayStageStatusChip",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string" },
    "stage_chip_id": { "type": "string" },
    "console_input_id": { "type": "string" },
    "stage_name": { "type": "string" },
    "stage_order_index": { "type": "integer" },
    "display_label": { "type": "string" },
    "status": { "type": "string", "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"] },
    "severity": { "type": "string", "enum": ["neutral", "pass", "review", "blocked", "unknown"] },
    "status_text": { "type": "string" },
    "reason_summary": { "type": "string" },
    "evidence_ref": { "type": "string" },
    "packet_ref": { "type": "string" },
    "packet_hash_ref": { "type": "string" },
    "is_current_stage": { "type": "boolean" },
    "is_blocking_stage": { "type": "boolean" },
    "action_enabled": { "type": "boolean" },
    "action_label": { "type": "string" },
    "manual_publish_only": { "type": "boolean" },
    "mock_only": { "type": "boolean" },
    "public_ready": { "type": "boolean" },
    "live_ready": { "type": "boolean" },
    "executable_dispatch": { "type": "boolean" },
    "api_gate_required": { "type": "boolean" },
    "validation_state": { "type": "string", "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"] },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "schema_version",
    "stage_chip_id",
    "console_input_id",
    "stage_name",
    "stage_order_index",
    "status",
    "severity",
    "action_enabled",
    "manual_publish_only",
    "mock_only",
    "public_ready",
    "live_ready",
    "executable_dispatch",
    "api_gate_required",
    "validation_state"
  ]
}
