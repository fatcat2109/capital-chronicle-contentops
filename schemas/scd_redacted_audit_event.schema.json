{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SCD RedactedAuditEvent",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string" },
    "audit_event_id": { "type": "string" },
    "created_at": { "type": "string" },
    "event_type": { "type": "string" },
    "related_packet_refs": { "type": "array", "items": { "type": "string" } },
    "redacted_request_placeholder": { "type": "string" },
    "redacted_response_placeholder": { "type": "string" },
    "secret_redaction_proof": {
      "type": "object",
      "properties": {
        "redaction_applied": { "type": "boolean" },
        "redacted_fields": { "type": "array", "items": { "type": "string" } },
        "unsafe_secret_detected": { "type": "boolean" }
      },
      "required": [
        "redaction_applied",
        "redacted_fields",
        "unsafe_secret_detected"
      ]
    },
    "operator_decision_ref": { "type": "string" },
    "network_accessed": { "type": "boolean" },
    "credential_accessed": { "type": "boolean" },
    "validation_state": {
      "type": "string",
      "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"]
    },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "schema_version",
    "audit_event_id",
    "created_at",
    "event_type",
    "related_packet_refs",
    "secret_redaction_proof",
    "network_accessed",
    "credential_accessed",
    "validation_state"
  ]
}
