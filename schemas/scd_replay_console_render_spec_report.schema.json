{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SCD ReplayConsoleRenderSpecReport",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string" },
    "render_spec_report_id": { "type": "string" },
    "render_spec_id": { "type": "string" },
    "view_model_id": { "type": "string" },
    "validated_layout_regions": { "type": "array", "items": { "type": "string" } },
    "validated_slot_bindings": { "type": "array", "items": { "type": "string" } },
    "validated_status_bindings": { "type": "array", "items": { "type": "string" } },
    "missing_required_regions": { "type": "array", "items": { "type": "string" } },
    "missing_required_slots": { "type": "array", "items": { "type": "string" } },
    "blocked_bindings": { "type": "array", "items": { "type": "string" } },
    "review_required_bindings": { "type": "array", "items": { "type": "string" } },
    "unknown_bindings": { "type": "array", "items": { "type": "string" } },
    "display_contract_complete": { "type": "boolean" },
    "no_ui_runtime_required": { "type": "boolean" },
    "no_browser_required": { "type": "boolean" },
    "no_screenshot_required": { "type": "boolean" },
    "no_html_css_js_edits": { "type": "boolean" },
    "no_api_required": { "type": "boolean" },
    "final_recommendation": { "type": "string", "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"] },
    "operator_next_action": { "type": "string" },
    "display_only": { "type": "boolean" },
    "action_enabled": { "type": "boolean" },
    "manual_publish_only": { "type": "boolean" },
    "mock_only": { "type": "boolean" },
    "public_ready": { "type": "boolean" },
    "live_ready": { "type": "boolean" },
    "executable_dispatch": { "type": "boolean" },
    "api_gate_required": { "type": "boolean" },
    "validation_state": { "type": "string", "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"] },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "schema_version",
    "render_spec_report_id",
    "render_spec_id",
    "view_model_id",
    "display_contract_complete",
    "no_ui_runtime_required",
    "no_browser_required",
    "no_screenshot_required",
    "no_html_css_js_edits",
    "no_api_required",
    "final_recommendation",
    "display_only",
    "action_enabled",
    "manual_publish_only",
    "mock_only",
    "public_ready",
    "live_ready",
    "executable_dispatch",
    "api_gate_required",
    "validation_state"
  ]
}
