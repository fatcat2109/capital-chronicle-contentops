{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Institutional Shell Prototype Packet",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "packet_id",
    "created_at",
    "task_label",
    "shell_mode",
    "runtime_authority",
    "static_local_only",
    "fixture_or_mock_data_only",
    "backend_server_required",
    "frontend_dependencies_added",
    "browser_automation_used_now",
    "antigravity_used_now",
    "credential_read_allowed_now",
    "platform_api_allowed_now",
    "live_posting_enabled_now",
    "scheduler_allowed_now",
    "scraping_allowed_now",
    "public_ready_final_copy_generated",
    "red_green_market_direction_semantics",
    "unsafe_signal_language_enabled",
    "secret_visible_count",
    "shell_files",
    "screens_rendered",
    "components_rendered",
    "safety_banners_rendered",
    "screenshot_safe_mode_present",
    "redaction_policy_visible",
    "blocked_action_policy_visible",
    "forbidden_controls_active_count",
    "external_dependency_count",
    "remote_url_count",
    "fetch_call_count",
    "active_frontend_code_changed_scope",
    "future_handoff",
    "blocked_reasons",
    "packet_status"
  ],
  "properties": {
    "packet_id": { "type": "string" },
    "created_at": { "type": "string" },
    "task_label": {
      "type": "string",
      "enum": ["TASK_CONTENTOPS_0160_INSTITUTIONAL_SHELL_PROTOTYPE_STATIC_LOCAL_V0"]
    },
    "shell_mode": { "type": "string", "enum": ["static_local_only"] },
    "runtime_authority": { "type": "boolean", "enum": [false] },
    "static_local_only": { "type": "boolean", "enum": [true] },
    "fixture_or_mock_data_only": { "type": "boolean", "enum": [true] },
    "backend_server_required": { "type": "boolean", "enum": [false] },
    "frontend_dependencies_added": { "type": "boolean", "enum": [false] },
    "browser_automation_used_now": { "type": "boolean", "enum": [false] },
    "antigravity_used_now": { "type": "boolean", "enum": [false] },
    "credential_read_allowed_now": { "type": "boolean", "enum": [false] },
    "platform_api_allowed_now": { "type": "boolean", "enum": [false] },
    "live_posting_enabled_now": { "type": "boolean", "enum": [false] },
    "scheduler_allowed_now": { "type": "boolean", "enum": [false] },
    "scraping_allowed_now": { "type": "boolean", "enum": [false] },
    "public_ready_final_copy_generated": { "type": "boolean", "enum": [false] },
    "red_green_market_direction_semantics": { "type": "boolean", "enum": [false] },
    "unsafe_signal_language_enabled": { "type": "boolean", "enum": [false] },
    "secret_visible_count": { "type": "integer", "enum": [0] },
    "shell_files": { "type": "array", "items": { "type": "string" }, "minItems": 5 },
    "screens_rendered": { "type": "array", "items": { "type": "string" }, "minItems": 12 },
    "components_rendered": { "type": "array", "items": { "type": "string" }, "minItems": 26 },
    "safety_banners_rendered": { "type": "array", "items": { "type": "string" }, "minItems": 9 },
    "screenshot_safe_mode_present": { "type": "boolean", "enum": [true] },
    "redaction_policy_visible": { "type": "boolean", "enum": [true] },
    "blocked_action_policy_visible": { "type": "boolean", "enum": [true] },
    "forbidden_controls_active_count": { "type": "integer", "enum": [0] },
    "external_dependency_count": { "type": "integer", "enum": [0] },
    "remote_url_count": { "type": "integer", "enum": [0] },
    "fetch_call_count": { "type": "integer", "enum": [0] },
    "active_frontend_code_changed_scope": { "type": "string" },
    "future_handoff": { "type": "object" },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } },
    "packet_status": { "type": "string", "enum": ["pass", "blocked", "fail"] }
  }
}
