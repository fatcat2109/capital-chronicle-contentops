{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SCD ApprovalLedgerEntry",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string" },
    "ledger_entry_id": { "type": "string" },
    "ledger_sequence": { "type": "integer" },
    "previous_ledger_entry_hash": { "type": ["string", "null"] },
    "entry_timestamp": { "type": "string" },
    "operator_decision_id": { "type": "string" },
    "approval_packet_id": { "type": "string" },
    "canonical_post_id": { "type": "string" },
    "compiler_output_id": { "type": "string" },
    "compile_report_id": { "type": "string" },
    "platform_payload_hash_refs": { "type": "array", "items": { "type": "string" } },
    "source_citation_refs": { "type": "array", "items": { "type": "string" } },
    "source_limitation_refs": { "type": "array", "items": { "type": "string" } },
    "decision_state": {
      "type": "string",
      "enum": ["approved_mock_only", "rejected", "revision_requested", "revoked", "blocked", "unknown"]
    },
    "append_only": { "type": "boolean" },
    "immutable_after_write": { "type": "boolean" },
    "secrets_redacted": { "type": "boolean" },
    "public_ready": { "type": "boolean" },
    "live_ready": { "type": "boolean" },
    "executable_dispatch": { "type": "boolean" },
    "validation_state": {
      "type": "string",
      "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"]
    },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "schema_version",
    "ledger_entry_id",
    "ledger_sequence",
    "entry_timestamp",
    "operator_decision_id",
    "decision_state",
    "append_only",
    "immutable_after_write",
    "secrets_redacted",
    "public_ready",
    "live_ready",
    "executable_dispatch",
    "validation_state"
  ]
}
