{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SCD MockDispatchRunReport",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string" },
    "mock_run_report_id": { "type": "string" },
    "mock_execution_request_id": { "type": "string" },
    "mock_execution_record_id": { "type": "string" },
    "manual_export_packet_id": { "type": "string" },
    "audit_binding_id": { "type": "string" },
    "per_platform_mock_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "platform_id": { "type": "string" },
          "result": { "type": "string", "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"] }
        },
        "required": ["platform_id", "result"]
      }
    },
    "blocked_platforms": { "type": "array", "items": { "type": "string" } },
    "review_required_platforms": { "type": "array", "items": { "type": "string" } },
    "pass_platforms": { "type": "array", "items": { "type": "string" } },
    "unknown_platforms": { "type": "array", "items": { "type": "string" } },
    "final_recommendation": {
      "type": "string",
      "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"]
    },
    "operator_next_action": { "type": "string" },
    "api_gate_required": { "type": "boolean" },
    "manual_publish_only": { "type": "boolean" },
    "live_ready": { "type": "boolean" },
    "executable_dispatch": { "type": "boolean" },
    "validation_state": {
      "type": "string",
      "enum": ["PASS", "BLOCKED", "REVIEW_REQUIRED", "UNKNOWN"]
    },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "schema_version",
    "mock_run_report_id",
    "mock_execution_request_id",
    "per_platform_mock_results",
    "final_recommendation",
    "api_gate_required",
    "manual_publish_only",
    "live_ready",
    "executable_dispatch",
    "validation_state"
  ]
}
