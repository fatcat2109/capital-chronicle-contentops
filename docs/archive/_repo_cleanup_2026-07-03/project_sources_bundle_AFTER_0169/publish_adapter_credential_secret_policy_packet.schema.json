    "no_secret_value_policy": { "type": "object" },
    "no_env_read_policy": { "type": "object" },
    "never_commit_secrets_policy": { "type": "object" },
    "future_operator_setup_gate": { "type": "object" },
    "future_credential_validation_gate": { "type": "object" },
    "audit_evidence_policy": { "type": "object" },
    "blocked_action_policy": { "type": "object" },
    "safety_policy": { "type": "object" },
    "future_live_handoff": { "type": "object" },
    "operator_warning_no_keys_needed_now": { "type": "string" },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } },
    "packet_status": { "type": "string" }
