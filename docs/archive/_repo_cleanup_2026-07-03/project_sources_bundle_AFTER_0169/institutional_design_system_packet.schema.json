{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Institutional Design System Packet",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "packet_id",
    "created_at",
    "task_label",
    "design_system_mode",
    "runtime_authority",
    "planning_only",
    "active_frontend_code_changed",
    "frontend_dependencies_added",
    "backend_server_required",
    "browser_automation_used_now",
    "antigravity_used_now",
    "credential_read_allowed_now",
    "platform_api_allowed_now",
    "live_posting_enabled_now",
    "scheduler_allowed_now",
    "scraping_allowed_now",
    "public_ready_final_copy_generated",
    "red_green_market_direction_semantics",
    "unsafe_signal_language_enabled",
    "secret_visible_count",
    "status_tokens",
    "component_taxonomy",
    "safety_banners",
    "screenshot_safe_rules",
    "forbidden_visual_metaphors",
    "handoff_to_view_model",
    "design_system_docs",
    "kill_switch_status",
    "blocked_reasons",
    "packet_status"
  ],
  "properties": {
    "packet_id": { "type": "string" },
    "created_at": { "type": "string" },
    "task_label": {
      "type": "string",
      "enum": ["TASK_CONTENTOPS_0158_INSTITUTIONAL_DESIGN_SYSTEM_AND_FUTURISTIC_FINTECH_VISUAL_CONTRACT_V0"]
    },
    "design_system_mode": { "type": "string", "enum": ["planning_only"] },
    "runtime_authority": { "type": "boolean", "enum": [false] },
    "planning_only": { "type": "boolean", "enum": [true] },
    "active_frontend_code_changed": { "type": "boolean", "enum": [false] },
    "frontend_dependencies_added": { "type": "boolean", "enum": [false] },
    "backend_server_required": { "type": "boolean", "enum": [false] },
    "browser_automation_used_now": { "type": "boolean", "enum": [false] },
    "antigravity_used_now": { "type": "boolean", "enum": [false] },
    "credential_read_allowed_now": { "type": "boolean", "enum": [false] },
    "platform_api_allowed_now": { "type": "boolean", "enum": [false] },
    "live_posting_enabled_now": { "type": "boolean", "enum": [false] },
    "scheduler_allowed_now": { "type": "boolean", "enum": [false] },
    "scraping_allowed_now": { "type": "boolean", "enum": [false] },
    "public_ready_final_copy_generated": { "type": "boolean", "enum": [false] },
    "red_green_market_direction_semantics": { "type": "boolean", "enum": [false] },
    "unsafe_signal_language_enabled": { "type": "boolean", "enum": [false] },
    "secret_visible_count": { "type": "integer", "enum": [0] },
    "status_tokens": { "type": "array", "items": { "type": "string" }, "minItems": 19 },
    "component_taxonomy": { "type": "array", "items": { "type": "string" }, "minItems": 26 },
    "safety_banners": { "type": "array", "items": { "type": "string" }, "minItems": 16 },
    "screenshot_safe_rules": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "forbidden_visual_metaphors": { "type": "array", "items": { "type": "string" }, "minItems": 9 },
    "handoff_to_view_model": { "type": "boolean", "enum": [true] },
    "design_system_docs": { "type": "array", "items": { "type": "string" }, "minItems": 5 },
    "kill_switch_status": { "type": "string" },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } },
    "packet_status": { "type": "string", "enum": ["pass", "blocked", "fail"] }
  }
}
