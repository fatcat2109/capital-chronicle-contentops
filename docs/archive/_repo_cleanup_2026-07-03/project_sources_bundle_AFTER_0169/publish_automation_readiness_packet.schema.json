{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "publish_automation_readiness_packet.schema.json",
  "title": "Publish Automation Readiness Packet",
  "type": "object",
  "required": ["packet_id", "readiness_mode", "packet_status"],
  "properties": {
    "packet_id": { "type": "string" },
    "created_at": { "type": "string" },
    "runtime_authority": { "type": "boolean" },
    "readiness_mode": { "type": "string" },
    "dry_run_only": { "type": "boolean" },
    "linked_ui_workflow_baseline": { "type": "string" },
    "platform_capability_registry_ref": { "type": "string" },
    "credentials_requested_now": { "type": "boolean" },
    "credential_read_allowed_now": { "type": "boolean" },
    "platform_api_allowed_now": { "type": "boolean" },
    "live_posting_enabled_now": { "type": "boolean" },
    "scheduler_allowed_now": { "type": "boolean" },
    "provider_llm_api_allowed_now": { "type": "boolean" },
    "repo_web_search_allowed_now": { "type": "boolean" },
    "scraping_allowed_now": { "type": "boolean" },
    "newsletter_or_cms_api_allowed_now": { "type": "boolean" },
    "backend_server_required": { "type": "boolean" },
    "publish_all_button_enabled_now": { "type": "boolean" },
    "one_button_publish_all_enabled_now": { "type": "boolean" },
    "publish_approval_system_created": { "type": "boolean" },
    "public_ready_approval_allowed_now": { "type": "boolean" },
    "final_social_copy_generated": { "type": "boolean" },
    "manual_review_required": { "type": "boolean" },
    "not_public_postable": { "type": "boolean" },
    "kill_switch_required": { "type": "boolean" },
    "redacted_audit_log_required": { "type": "boolean" },
    "operator_action_required_now_for_credentials": { "type": "boolean" },
    "operator_action_required_later_for_credentials": { "type": "boolean" },
    "publish_batch_model": { "type": "object" },
    "dry_run_payload_model": { "type": "object" },
    "manual_approval_gate_model": { "type": "object" },
    "kill_switch_model": { "type": "object" },
    "credential_policy_future_only": { "type": "object" },
    "audit_log_policy": { "type": "object" },
    "idempotency_policy": { "type": "object" },
    "partial_failure_policy": { "type": "object" },
    "blocked_action_policy": { "type": "object" },
    "safety_policy": { "type": "object" },
    "readiness_gates": { "type": "object" },
    "future_task_sequence": { "type": "array", "items": { "type": "string" } },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } },
    "packet_status": { "type": "string" }
  }
}
