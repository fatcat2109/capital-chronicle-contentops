{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Institutional Pre-Antigravity Static QA Hardening Packet",
  "type": "object",
  "properties": {
    "packet_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "task_label": { "type": "string" },
    "qa_mode": { "type": "string" },
    "runtime_authority": { "type": "boolean" },
    "static_local_only": { "type": "boolean" },
    "fixture_or_mock_data_only": { "type": "boolean" },
    "pre_antigravity_only": { "type": "boolean" },
    "browser_automation_used_now": { "type": "boolean" },
    "antigravity_used_now": { "type": "boolean" },
    "screenshot_capture_enabled_now": { "type": "boolean" },
    "file_export_enabled_now": { "type": "boolean" },
    "platform_upload_enabled_now": { "type": "boolean" },
    "active_frontend_code_changed_scope": { "type": "string" },
    "backend_server_required": { "type": "boolean" },
    "frontend_dependencies_added": { "type": "boolean" },
    "credential_read_allowed_now": { "type": "boolean" },
    "platform_api_allowed_now": { "type": "boolean" },
    "provider_llm_api_allowed_now": { "type": "boolean" },
    "repo_web_search_allowed_now": { "type": "boolean" },
    "live_posting_enabled_now": { "type": "boolean" },
    "scheduler_allowed_now": { "type": "boolean" },
    "scraping_allowed_now": { "type": "boolean" },
    "public_ready_final_copy_generated": { "type": "boolean" },
    "evidence_mutation_enabled_now": { "type": "boolean" },
    "screen_inventory": { "type": "object" },
    "navigation_coverage": { "type": "object" },
    "static_runtime_safety": { "type": "object" },
    "disabled_controls_integrity": { "type": "object" },
    "screenshot_safe_readiness": { "type": "object" },
    "secrets_redaction": { "type": "object" },
    "content_safety": { "type": "object" },
    "manual_workflow_safety": { "type": "object" },
    "evidence_vault_safety": { "type": "object" },
    "antigravity_handoff": { "type": "object" },
    "manual_open_runbook": { "type": "object" },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } },
    "packet_status": { "type": "string" }
  },
  "required": [
    "packet_id", "created_at", "task_label", "qa_mode", "runtime_authority",
    "static_local_only", "fixture_or_mock_data_only", "pre_antigravity_only",
    "browser_automation_used_now", "antigravity_used_now", "screenshot_capture_enabled_now",
    "file_export_enabled_now", "platform_upload_enabled_now", "active_frontend_code_changed_scope",
    "backend_server_required", "frontend_dependencies_added", "credential_read_allowed_now",
    "platform_api_allowed_now", "provider_llm_api_allowed_now", "repo_web_search_allowed_now",
    "live_posting_enabled_now", "scheduler_allowed_now", "scraping_allowed_now",
    "public_ready_final_copy_generated", "evidence_mutation_enabled_now", "screen_inventory",
    "navigation_coverage", "static_runtime_safety", "disabled_controls_integrity",
    "screenshot_safe_readiness", "secrets_redaction", "content_safety", "manual_workflow_safety",
    "evidence_vault_safety", "antigravity_handoff", "manual_open_runbook", "blocked_reasons", "packet_status"
  ]
}
