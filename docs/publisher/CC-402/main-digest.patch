+def _weekly_audience(reader, store, now):
+    """CC-402: read Publisher's existing export; never collect or write its store."""
+    path = Path(store).parent / "daily_app_outputs" / "weekly-engagement" / "engagement.json" if store else None
+    doc = reader.read(path, "ContentOps weekly audience")
+    if doc is None:
+        return {"state": "MISSING", "path": str(path), "lines": []}
+    try:
+        stamp = _utc(doc["recorded_at_utc"])
+        lines = doc["digest_lines"]
+        if (doc.get("schema_version") != "contentops.weekly_channel_engagement.v1"
+                or stamp > now or not isinstance(lines, list)
+                or not all(isinstance(line, str) for line in lines)):
+            raise ValueError("CONTENTOPS_WEEKLY_AUDIENCE_INVALID")
+        return {"state": "SAVED_RECORD", "path": str(path), "week_ending": doc["week_ending"],
+                "observed_at_utc": _iso(stamp), "age_hours": round((now - stamp).total_seconds() / 3600, 1),
+                "metric_basis": doc["metric_basis"], "lines": lines}
+    except (ValueError, TypeError, KeyError) as exc:
+        return {"state": "MISSING", "path": str(path), "lines": [], "reason": str(exc)}
