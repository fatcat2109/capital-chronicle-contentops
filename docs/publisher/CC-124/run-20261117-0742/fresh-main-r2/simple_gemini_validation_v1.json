  "supported_material_claims": [
    {
      "attribution_required": true,
      "claim_id": "btc-body-01",
      "claim_kind": "FACT",
      "claim_text": "We remain on the sidelines in Bitcoin while it stays inside its two-day range after the broader selloff. Our analysis offers a weak bearish lean, without an established entry setup.",
      "document_id": "cc124-btc-range-20261117-r2",
      "source_id": "SOURCE_1",
      "support_excerpt_sha256": "abddbf8c0c6011dc86701191a06c283d1e35145130d98a4495a07cee4baadeef",
      "support_status": "SUPPORTED_EXACT_RETAINED_MAIN_REPORT_SPANS"
    },
    {
      "attribution_required": true,
      "claim_id": "btc-body-02",
      "claim_kind": "NUMBER",
      "claim_text": "On our spot reference scale, the two-day band runs from 63829.52 to 65637.9 US dollars per Bitcoin. The scenario reference is 64451.95, inside that band. Readers following Bitcoin through the IBIT ETF should keep these spot levels separate from the ETF price.",
      "document_id": "cc124-btc-range-20261117-r2",
      "source_id": "SOURCE_1",
      "support_excerpt_sha256": "abddbf8c0c6011dc86701191a06c283d1e35145130d98a4495a07cee4baadeef",
      "support_status": "SUPPORTED_EXACT_RETAINED_MAIN_REPORT_SPANS"
    },
    {
      "attribution_required": true,
      "claim_id": "btc-body-03",
      "claim_kind": "NUMBER",
      "claim_text": "That range follows the fall from 73986.7 to the November 15 low of 61940.88. We have not observed positioning or a confirming break in this assessment.",
      "document_id": "cc124-btc-range-20261117-r2",
      "source_id": "SOURCE_1",
      "support_excerpt_sha256": "d27793319489197711b4ed437806a25fe60f317782bef21af9db8aca03757c9a",
      "support_status": "SUPPORTED_EXACT_RETAINED_MAIN_REPORT_SPANS"
    },
    {
      "attribution_required": true,
      "claim_id": "btc-body-04",
      "claim_kind": "FACT",
      "claim_text": "A forecast describes where price may be at a stated time. A setup also needs an observable condition that changes the view. Our assessment has no frozen entry zone. The weak directional lean therefore leaves the stand-aside call intact.",
      "document_id": "cc124-btc-range-20261117-r2",
      "source_id": "SOURCE_1",
      "support_excerpt_sha256": "abddbf8c0c6011dc86701191a06c283d1e35145130d98a4495a07cee4baadeef",
      "support_status": "SUPPORTED_EXACT_RETAINED_MAIN_REPORT_SPANS"
    },
    {
      "attribution_required": true,
      "claim_id": "btc-body-05",
      "claim_kind": "NUMBER",
      "claim_text": "The horizon is November seventeenth at seven thirty-seven p.m. ET, forty-four seconds into that minute. Both estimates concern that same instant on our Bitcoin spot reference scale.",
      "document_id": "cc124-btc-range-20261117-r2",
      "source_id": "SOURCE_1",
      "support_excerpt_sha256": "a41b03c0e93bc74e5376f1907469ab8bff0d8bdb0935a8e33f426e5c28bbf1ea",
      "support_status": "SUPPORTED_EXACT_RETAINED_MAIN_REPORT_SPANS"
    },
    {
      "attribution_required": true,
      "claim_id": "btc-body-06",
      "claim_kind": "NUMBER",
      "claim_text": "**Base case — 54% Capital Chronicle model estimate, uncalibrated.** Bitcoin is at or below the reference 64451.95 at that horizon. Confirmations: none observed.",
      "document_id": "cc124-btc-range-20261117-r2",
      "source_id": "SOURCE_1",
      "support_excerpt_sha256": "1605f9d1784dcc0b4cc210cc953c156cdd7a640d993e96a8deba262ef8f007ee",
      "support_status": "SUPPORTED_EXACT_RETAINED_MAIN_REPORT_SPANS"
    },
    {
      "attribution_required": true,
      "claim_id": "btc-body-07",
      "claim_kind": "NUMBER",
      "claim_text": "**Alternative — 46% Capital Chronicle model estimate, uncalibrated.** Bitcoin is above 64451.95 at the same horizon. A squeeze through 65637.9 after two days of failed selling is the opposing mechanism.",
      "document_id": "cc124-btc-range-20261117-r2",
      "source_id": "SOURCE_1",
      "support_excerpt_sha256": "e3bce481e203a267312cbb9e6c3f9dbbc6e778d8686df7a816c1ff387319849e",
      "support_status": "SUPPORTED_EXACT_RETAINED_MAIN_REPORT_SPANS"
    },
    {
      "attribution_required": true,
      "claim_id": "btc-body-08",
      "claim_kind": "NUMBER",
      "claim_text": "In either scenario, the range assessment changes if a completed one-hour bar closes below 63829.52 or above 65637.9. A lower close makes a short a candidate for the next review. An upper close removes the short lean. Neither condition is an automatic trade.",
      "document_id": "cc124-btc-range-20261117-r2",
      "source_id": "SOURCE_1",
      "support_excerpt_sha256": "2e0435fb3d3842a40710b8a0b19292639bfc2211bec25e528ea0b906d25b2dfc",
      "support_status": "SUPPORTED_EXACT_RETAINED_MAIN_REPORT_SPANS"
    },
    {
      "attribution_required": true,
      "claim_id": "btc-body-09",
      "claim_kind": "FACT",
      "claim_text": "These are outcome estimates, not trade win rates or probabilities of an entry becoming valid. Across the wider assessment, the other markets remain stand-asides. Those are dated context; these Bitcoin estimates assign them no joint outcome.",
      "document_id": "cc124-btc-range-20261117-r2",
      "source_id": "SOURCE_1",
      "support_excerpt_sha256": "a41b03c0e93bc74e5376f1907469ab8bff0d8bdb0935a8e33f426e5c28bbf1ea",
      "support_status": "SUPPORTED_EXACT_RETAINED_MAIN_REPORT_SPANS"
    },
    {
      "attribution_required": true,
      "claim_id": "btc-body-10",
      "claim_kind": "FACT",
      "claim_text": "So what: watch a completed one-hour close beyond the band before reconsidering the range assessment. A move below the reference alone does not establish the lower-band break. A move above the reference can still leave Bitcoin inside its range.",
      "document_id": "cc124-btc-range-20261117-r2",
      "source_id": "SOURCE_1",
      "support_excerpt_sha256": "a41b03c0e93bc74e5376f1907469ab8bff0d8bdb0935a8e33f426e5c28bbf1ea",
