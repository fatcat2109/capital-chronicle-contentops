diff --git a/tests/test_native_neo_executor_v1.py b/tests/test_native_neo_executor_v1.py
index 2acc8895..8fd16f4d 100644
--- a/tests/test_native_neo_executor_v1.py
+++ b/tests/test_native_neo_executor_v1.py
@@ -283,3 +283,35 @@ def test_readonly_publish_and_unclaimed_or_wrong_return_fail_closed(tmp_path):
     packet, _, _ = pending_readback(adapter)
     with pytest.raises(ValueError, match="BINDING"):
