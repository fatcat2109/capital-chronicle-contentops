        "claim_id": "CC323_CARD_1",
        "text": "The review places gold's upward move at 05:00-07:00 UTC (12:00-14:00 Bangkok), with US500 turning up from 04:00 UTC (11:00 Bangkok).",
        "source_id": "SOURCE_1",
        "document_id": "cc323-midterm-lesson-20261106",
        "support_excerpt": "Gold 05:00-07:00Z (12:00-14:00)\n\nUS500 04:00Z (11:00) A steady climb through Asia and Europe:",
        "source_content_sha256": "b38301dfef9834244c0635590598ccf39e518af42a4dde5d21ea17e4400badde",
        "rights_class": "capital_chronicle_own_report",
