    },
    {
      "claim_id": "CC323_MAPPING",
      "claim_text": "According to the review, the dossier mapped a Democratic House and Senate to falling US500, USTEC and Bitcoin. It instead records rises in those markets. The same review says the gold-up and USD-down legs matched. That is a mixed direction check, not grounds to turn the election call into a claim of investing success.",
      "claim_kind": "FACT",
      "source_id": "SOURCE_1",
      "document_id": "cc323-midterm-lesson-20261106",
      "support_status": "SUPPORTED_EXACT_RETAINED_MAIN_REPORT_SPANS",
