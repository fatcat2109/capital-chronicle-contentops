    {
      "schema_version": "contentops.main_headline_projection.v1",
      "headline_id": "goal21-gas-series-migration",
      "headline_text": "This week is the final publication of the Natural Gas Weekly Update. On January 29, we are launching the Weekly Natural Gas Storage Report (WNGSR) Supplement on EIA's Beta site. This supplement will be published every Thursday afternoon. You can find information on our upcoming releases and how to contact us on our website.",
      "text_sha256": "946c283627f3fcc1eb6a800157a8d8fdb5ff046b57274a8b8a1e96722a8797b8",
      "source_identity": "www.eia.gov",
