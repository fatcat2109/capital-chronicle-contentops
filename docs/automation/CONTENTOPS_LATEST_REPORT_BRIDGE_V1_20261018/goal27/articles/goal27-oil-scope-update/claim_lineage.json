  {
    "attribution_required": true,
    "claim_id": "oil-retained-stocks",
    "claim_kind": "NUMBER",
    "claim_text": "For the October 9, 2026 observation, the retained EIA summary records commercial crude inventories, excluding the Strategic Petroleum Reserve, falling by 8.6 million barrels to 415.6 million barrels, 3% below their five-year average. Gasoline inventories rose by 3.5 million barrels and stood 4% below their average; distillate stocks fell by 2.5 million barrels and were 12% below their average. These are the unchanged stock observations underlying the revision.",
    "document_id": "goal27-oil-original",
    "source_id": "SOURCE_2",
    "support_excerpt_sha256": "e9ec4abbafbe8fe2e4356e03f0f0ce0cb05d446872abfb3a26889aaa46c2966b",
    "support_status": "SUPPORTED_EXACT_RETRIEVED_SOURCE_BYTES"
  },
  {
    "attribution_required": true,
    "claim_id": "oil-stock-change-mechanism-limit",
    "claim_kind": "FACT",
    "claim_text": "Capital Chronicle's reading is that a fall in stored crude describes a change in the buffer; it does not identify which flows produced it. EIA's gasoline build also leaves the stronger-demand explanation open.",
    "document_id": "goal27-oil-original",
    "source_id": "SOURCE_2",
    "support_excerpt_sha256": "e9ec4abbafbe8fe2e4356e03f0f0ce0cb05d446872abfb3a26889aaa46c2966b",
    "support_status": "SUPPORTED_EXACT_RETRIEVED_SOURCE_BYTES"
