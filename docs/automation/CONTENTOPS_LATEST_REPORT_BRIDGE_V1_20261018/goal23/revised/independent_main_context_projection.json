    {
      "schema_version": "contentops.main_headline_projection.v1",
      "headline_id": "goal21-sec-cross-trading",
      "headline_text": "The proposed amendments would restore the ability to cross trade most fixed-income securities and modernize the rule’s conditions, including those related to pricing and oversight of cross trades. These modernizations would, among other things, recognize market developments that have led to pricing that is more verifiable and transparent. The proposal would also require aggregated reporting of trading activity and cross trades by registered funds that engage in cross trading to provide additional transparency.",
      "text_sha256": "d5d8038c797f1b4e45054db2a97d1f9b7ba325b77cb1938657dc75873e586405",
      "source_identity": "www.sec.gov",
      "source_platform": "CONTENTOPS_ORIGINAL_OFFICIAL_ACQUISITION",
      "reporting_identity": "www.sec.gov",
      "source_url": "https://www.sec.gov/newsroom/press-releases/2026-104-sec-proposes-expanding-securities-eligible-cross-trading-registered-funds",
