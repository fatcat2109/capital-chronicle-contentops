{"allowed_consumers": ["internal_research", "narrative_context"], "candidate_catalyst_tags": ["energy", "electricity", "gas"], "captured_at_utc": "2026-10-19T05:48:41.968967Z", "claimed_origins": ["https://www.eia.gov/todayinenergy/detail.php?id=68305"], "context_only": true, "correction_of": null, "headline_id": "goal20-eia-grid-peaks", "headline_text": "PJM peaked at 162.6 gigawatts (GW) on July 2, 2026, 1.3% higher than the pre-2026 peak of 160.6 GW on June 23, 2025. The Electric Reliability Council of Texas (ERCOT) peaked at 91.1 GW on July 22, 2026, 6.5% higher than the pre-2026 record of 85.5 GW on August 20, 2024. The Southwest Power Pool (SWPP) peaked at 58.0 GW on July 27, 2026, 3.5% higher than the pre-2026 peak of 56.0 GW on August 21, 2023.", "headline_timestamp": "2026-10-15T00:00:00Z", "known_at_utc": "2026-10-19T05:48:41.968967Z", "numeric_authority_granted": false, "originality": "INDEPENDENT_CONTENTOPS_ACQUISITION", "permitted_uses": ["INTERNAL_ATTRIBUTED_REPORT_CONTEXT"], "projection_sha256": "6920ca870e16907bb8c1b926b519c3089c4d9bd3b7d2d97d82870426f45d7e2a", "public_republication_authority": false, "report_truth_only": true, "reporting_identity": "www.eia.gov", "retrieval_time_utc": "2026-10-19T05:48:41.968967Z", "revision_at_utc": "2026-10-19T05:48:43.900609Z", "rights_evidence_sha256": "821ec2732035327f4df9e116780a7e1a3e93afa2c885067acb192d27b2d60df3", "rights_state": {"INTERNAL_ANALYSIS_ALLOWED": true, "LLM_INPUT_ALLOWED": true, "MODEL_INPUT_ALLOWED": true, "provider_safe": true}, "schema_version": "contentops.main_headline_projection.v1", "source_capture_sha256": "50e024dd01b7176224830dff73f79abc8ce1365daa8f0139d928e14e86767009", "source_identity": "www.eia.gov", "source_permission_record_sha256": "00e88379582877331caa3a165c908d21cbd0f2a8b7b5b5c869668e2518203c28", "source_platform": "CONTENTOPS_ORIGINAL_OFFICIAL_ACQUISITION", "source_record_locator": {"retained_authority": "SEALED_MAIN_PUBLIC_REPORT"}, "source_url": "https://www.eia.gov/todayi