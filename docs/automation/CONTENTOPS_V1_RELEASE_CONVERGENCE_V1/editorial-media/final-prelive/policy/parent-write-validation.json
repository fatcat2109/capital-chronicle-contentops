        "support_excerpt_sha256": "539257f732aeab806384a9631b098e887ec5b8b9194761b7f3121e4ac5c30ef6"
      },
      {
        "claim_id": "policy-tool-roles-interpretation",
        "claim_text": "Capital Chronicle's interpretation is that the three settings address different sides of cash management: remuneration for reserve balances, temporary cash provision through standing repo, and overnight cash placement through reverse repo. That distinction helps explain how the tools serve a shared policy objective; it does not establish that a particular operation occurred or that a customer's bank rate changed.",
        "claim_kind": "FACT",
        "source_id": "SOURCE_1",
