{
  "schema": "contentops.v2.global_locale_registry.v2",
  "configuration_rule": "Locales are capability declarations. New locales extend registry data and governed semantic forms; they never create locale-specific picture source or a default picture render.",
  "production_policy": {
    "picture_render_once_per_editorial_format": true,
    "locale_picture_render_default": false,
    "burned_captions": "OPTIONAL_ONLY_EXACT_AUTHORITY_REQUIRED",
    "recurring_locale_creative_xhigh": false,
    "translation_authority": "GOVERNED_SEMANTIC_SEGMENTS_PLUS_DETERMINISTIC_ANCHORS"
  },
  "profiles": {
    "CORE_ALWAYS_ON": ["en", "es", "pt-BR", "zh-Hans", "hi", "id", "ar", "vi", "ja", "ko", "fr", "de"],
