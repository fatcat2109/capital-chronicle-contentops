# Python caches
__pycache__/
*.pyc

# Build / local output
outputs/

# Secrets and local environment files — never commit
.env
.env.local
.env.*
!.env.example
!*.env.example

# Secret material and key files
*.pem
*.key
secrets.json
credentials.json

# Logs
*.log
logs/

# Operator browser / OAuth local secrets
operator-browser-profiles/
.browser-profiles/
.oauth-token-cache/
.oauth-callback-cache/
*.client_secret.json
client_secret*.json
*oauth*token*.json
*credential*cache*.json
*.local.secret
*.local.secrets.json

# Local Operator Evidence Fixture - Do Not Commit Real Evidence
docs/automation/V6_OPERATOR_EVIDENCE_CONSOLE/operator_evidence_fixture.json

# Local Operator Signature Files
docs/automation/V6_OPERATOR_APPROVAL_CAPTURE/operator_approval_signature.local.json
docs/automation/V6_OPERATOR_APPROVAL_SIGNATURE_BINDING/operator_signature.json

# Generated dependencies / local scratch artifacts
node_modules/
scratch/temp_profile_*/
scratch/archive/
scratch/*.png
scratch/*.jpg
scratch/*.jpeg
scratch/*.webp
scratch/*.html

# SQLite database, WAL, SHM, restore, and backup files — never commit mutable databases
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite.bak
*.sqlite.bak.*
*.db
*.db-wal
*.db-shm
*.db.bak
*.db.bak.*
*.restore

# Tier-2 Remotion runtime staging media (regenerated at render time; kept outside Git)
video/remotion/public/assets/
video/remotion/public/narration/
video/remotion/.remotion/
video/remotion/out/
video/remotion/node_modules/
