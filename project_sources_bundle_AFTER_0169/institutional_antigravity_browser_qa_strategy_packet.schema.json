{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Institutional Antigravity Browser QA Strategy Packet",
  "type": "object",
  "required": [
    "packet_id", "created_at", "task_label", "runbook_mode",
    "runtime_authority", "strategy_only", "browser_opened_now",
    "browser_automation_used_now", "antigravity_used_now",
    "screenshot_capture_enabled_now", "file_export_enabled_now",
    "platform_upload_enabled_now", "static_local_only",
    "credential_read_allowed_now", "platform_api_allowed_now",
    "provider_llm_api_allowed_now", "repo_web_search_allowed_now",
    "live_posting_enabled_now", "scheduler_allowed_now",
    "scraping_allowed_now", "evidence_mutation_enabled_now",
    "browser_qa_purpose", "browser_qa_non_goals", "allowed_browser_target",
    "explicit_forbidden_actions", "manual_screen_checklist",
    "high_priority_screen_checks", "future_browser_qa_evidence_packet_template",
    "future_browser_qa_pass_criteria", "future_browser_qa_blocked_criteria",
    "future_browser_qa_fail_criteria", "stop_conditions",
    "future_next_task_guidance", "blocked_reasons", "packet_status"
  ],
  "properties": {
    "packet_id": {"type": "string"},
    "created_at": {"type": "string"},
    "task_label": {"type": "string"},
    "runbook_mode": {"type": "string"},
    "runtime_authority": {"type": "boolean", "const": false},
    "strategy_only": {"type": "boolean", "const": true},
    "browser_opened_now": {"type": "boolean", "const": false},
    "browser_automation_used_now": {"type": "boolean", "const": false},
    "antigravity_used_now": {"type": "boolean", "const": false},
    "screenshot_capture_enabled_now": {"type": "boolean", "const": false},
    "file_export_enabled_now": {"type": "boolean", "const": false},
    "platform_upload_enabled_now": {"type": "boolean", "const": false},
    "static_local_only": {"type": "boolean", "const": true},
    "credential_read_allowed_now": {"type": "boolean", "const": false},
    "platform_api_allowed_now": {"type": "boolean", "const": false},
    "provider_llm_api_allowed_now": {"type": "boolean", "const": false},
    "repo_web_search_allowed_now": {"type": "boolean", "const": false},
    "live_posting_enabled_now": {"type": "boolean", "const": false},
    "scheduler_allowed_now": {"type": "boolean", "const": false},
    "scraping_allowed_now": {"type": "boolean", "const": false},
    "evidence_mutation_enabled_now": {"type": "boolean", "const": false},
    "browser_qa_purpose": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "browser_qa_non_goals": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "allowed_browser_target": {"type": "object"},
    "explicit_forbidden_actions": {"type": "array", "items": {"type": "string"}, "minItems": 9},
    "manual_screen_checklist": {"type": "array", "minItems": 12},
    "high_priority_screen_checks": {"type": "array", "minItems": 6},
    "future_browser_qa_evidence_packet_template": {"type": "array", "items": {"type": "string"}, "minItems": 11},
    "future_browser_qa_pass_criteria": {"type": "array", "items": {"type": "string"}, "minItems": 3},
    "future_browser_qa_blocked_criteria": {"type": "array", "items": {"type": "string"}, "minItems": 2},
    "future_browser_qa_fail_criteria": {"type": "array", "items": {"type": "string"}, "minItems": 4},
    "stop_conditions": {"type": "array", "items": {"type": "string"}, "minItems": 4},
    "future_next_task_guidance": {"type": "object"},
    "blocked_reasons": {"type": "array"},
    "packet_status": {"type": "string", "enum": ["pass", "blocked", "fail"]},
    "kill_switch_status": {"type": "string"}
  }
}
