{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Institutional UI/UX Front-End Rebuild Plan Packet",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "packet_id",
    "created_at",
    "runtime_authority",
    "task_label",
    "ui_rebuild_mode",
    "active_frontend_code_changed",
    "backend_server_required",
    "browser_automation_used_now",
    "antigravity_used_now",
    "credential_read_allowed_now",
    "platform_api_allowed_now",
    "live_posting_enabled_now",
    "scheduler_allowed_now",
    "scraping_allowed_now",
    "public_ready_final_copy_generated",
    "manual_review_required",
    "not_public_postable",
    "safety_banners_required",
    "secret_visible_count",
    "signal_language_allowed",
    "master_plan_doc",
    "backlog_doc",
    "quality_matrix_doc",
    "antigravity_strategy_doc",
    "phase_task_labels",
    "status_token_vocabulary",
    "kill_switch_status",
    "blocked_reasons",
    "packet_status"
  ],
  "properties": {
    "packet_id": { "type": "string" },
    "created_at": { "type": "string" },
    "runtime_authority": { "type": "boolean", "enum": [false] },
    "task_label": {
      "type": "string",
      "enum": ["TASK_CONTENTOPS_0157_INSTITUTIONAL_UI_UX_FRONTEND_REBUILD_MASTER_PLAN_V0"]
    },
    "ui_rebuild_mode": { "type": "string", "enum": ["planning_only"] },
    "active_frontend_code_changed": { "type": "boolean", "enum": [false] },
    "backend_server_required": { "type": "boolean", "enum": [false] },
    "browser_automation_used_now": { "type": "boolean", "enum": [false] },
    "antigravity_used_now": { "type": "boolean", "enum": [false] },
    "credential_read_allowed_now": { "type": "boolean", "enum": [false] },
    "platform_api_allowed_now": { "type": "boolean", "enum": [false] },
    "live_posting_enabled_now": { "type": "boolean", "enum": [false] },
    "scheduler_allowed_now": { "type": "boolean", "enum": [false] },
    "scraping_allowed_now": { "type": "boolean", "enum": [false] },
    "public_ready_final_copy_generated": { "type": "boolean", "enum": [false] },
    "manual_review_required": { "type": "boolean", "enum": [true] },
    "not_public_postable": { "type": "boolean", "enum": [true] },
    "safety_banners_required": { "type": "boolean", "enum": [true] },
    "secret_visible_count": { "type": "integer", "enum": [0] },
    "signal_language_allowed": { "type": "boolean", "enum": [false] },
    "master_plan_doc": { "type": "string" },
    "backlog_doc": { "type": "string" },
    "quality_matrix_doc": { "type": "string" },
    "antigravity_strategy_doc": { "type": "string" },
    "phase_task_labels": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 11
    },
    "status_token_vocabulary": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 10
    },
    "kill_switch_status": { "type": "string" },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } },
    "packet_status": { "type": "string", "enum": ["pass", "blocked", "fail"] }
  }
}
